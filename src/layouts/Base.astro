---
// Plantilla base de todas las páginas: <head> con SEO, Google Tag Manager
// (con Consent Mode), cabecera, pie y banner de cookies.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { SITE, CONTACT } from '../data/site.js';

const {
  title,
  description = SITE.defaultDescription,
  image = SITE.defaultImage,
  type = 'website',
  noindex = false,
  canonicalPath = null,
  schema = [],
  headerVariant = 'light',
  pageClass = '', // clase del <main> que da ámbito a la hoja de estilos de cada página
} = Astro.props;

const canonical = new URL(canonicalPath || Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  alternateName: 'Robin',
  url: `${SITE.url}/`,
  logo: new URL(SITE.logo, SITE.url).href,
  slogan: SITE.slogan,
  description:
    'Project Robin acompaña a estudiantes españoles y a sus familias en todo el proceso de estudiar un grado en Holanda (Países Bajos): elección de universidad, admisión, alojamiento y llegada.',
  email: CONTACT.email,
  telephone: CONTACT.phone,
  address: { '@type': 'PostalAddress', addressLocality: 'Madrid', addressCountry: 'ES' },
  areaServed: 'ES',
  sameAs: [CONTACT.linkedin],
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: SITE.name,
  url: `${SITE.url}/`,
  inLanguage: 'es-ES',
  publisher: { '@id': `${SITE.url}/#organization` },
};

const schemas = [organization, website, ...(Array.isArray(schema) ? schema : [schema])];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <meta name="theme-color" content="#173f5f" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />}

    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${title} | ${SITE.name}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/png" sizes="32x32" href="/wp-content/uploads/2024/12/estudiar-en-holanda-project-robin-logo-150x150.png" />
    <link rel="apple-touch-icon" href="/wp-content/uploads/2024/12/estudiar-en-holanda-project-robin-logo-300x300.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Consent Mode v2: todo denegado hasta que el usuario acepte en el banner -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        functionality_storage: 'denied',
        personalization_storage: 'denied',
        security_storage: 'granted',
        wait_for_update: 500,
      });
      try {
        // Misma versión y caducidad que src/components/CookieBanner.astro
        var saved = JSON.parse(localStorage.getItem('robin-consent') || 'null');
        var valid = saved && saved.v === 2 && Date.now() - new Date(saved.date).getTime() <= 365 * 864e5;
        if (valid) {
          gtag('consent', 'update', {
            analytics_storage: saved.analytics ? 'granted' : 'denied',
            ad_storage: saved.ads ? 'granted' : 'denied',
            ad_user_data: saved.ads ? 'granted' : 'denied',
            ad_personalization: saved.ads ? 'granted' : 'denied',
            functionality_storage: 'granted',
            personalization_storage: saved.analytics ? 'granted' : 'denied',
          });
        }
      } catch (e) {}
    </script>

    <!-- Google Tag Manager -->
    <script is:inline define:vars={{ gtmId: SITE.gtmId }}>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', gtmId);
    </script>

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <slot name="head" />
  </head>
  <body>
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${SITE.gtmId}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"></iframe>
    </noscript>
    <a class="skip-link" href="#contenido">Ir al contenido</a>
    <Header variant={headerVariant} />
    <main id="contenido" class={pageClass || undefined}>
      <slot />
    </main>
    <Footer />
    <CookieBanner />
  </body>
</html>
