---
import Base from '../../layouts/Base.astro';
import ContactSection from '../../components/ContactSection.astro';
import { SERVICIOS } from '../../data/servicios.js';
---

<Base
  title="Servicios para estudiar en Holanda | Project Robin"
  description="Conoce los servicios de Project Robin para elegir universidad, gestionar la admisión, encontrar alojamiento y preparar tu llegada a Holanda."
>
  <section class="container packs-wrap">
    <p class="eyebrow center">Servicios</p>
    <h1 class="display center">Nuestros paquetes</h1>
    <p class="lead center">Nos adaptamos a ti para que estudiar en los Países Bajos sea simple</p>

    <div class="packs">
      {
        SERVICIOS.map((s) => (
          <article class:list={['pack', { popular: s.popular }]}>
            {s.popular && <p class="badge">Más popular</p>}
            <h2>{s.name}</h2>
            <ul class="tick-list">
              {s.card.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
            <p class="small">{s.card.text}</p>
            <a class="btn btn-navy btn-sm" href={`/servicios/${s.slug}/`}>
              Ver más
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <div class="bg-sky">
    <ContactSection tag="servicios" />
  </div>
</Base>

<style>
  .packs-wrap {
    padding-block: 60px 90px;
  }
  .display {
    margin: 14px 0 12px;
  }
  .packs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
    margin-top: 70px;
    align-items: stretch;
  }
  .pack {
    position: relative;
    background: #dde2f1;
    border: 2px solid var(--navy);
    border-radius: 16px;
    padding: 90px 28px 34px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .badge {
    position: absolute;
    top: -2px;
    left: -2px;
    right: -2px;
    background: var(--navy);
    color: var(--cream);
    text-align: center;
    padding: 14px;
    border-radius: 16px 16px 0 0;
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    transform: translateY(-40px);
  }
  .pack h2 {
    text-align: center;
    font-size: 26px;
    font-weight: 700;
  }
  .pack .tick-list {
    font-size: 16px;
    font-weight: 700;
  }
  .pack .small {
    flex: 1;
  }
  .pack .btn {
    align-self: center;
  }
  @media (max-width: 1200px) {
    .packs {
      grid-template-columns: repeat(2, minmax(0, 420px));
      justify-content: center;
      row-gap: 70px;
    }
  }
  @media (max-width: 950px) {
    .packs {
      grid-template-columns: 1fr;
      max-width: 460px;
      margin-inline: auto;
      gap: 70px;
    }
  }
</style>
