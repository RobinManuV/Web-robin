---
import UniversityPage from '../../components/UniversityPage.astro';
import { EUROPEAN_EXPERIENCE } from '../../data/universidades.js';

export function getStaticPaths() {
  return EUROPEAN_EXPERIENCE.map((e) => ({ params: { slug: e.slug }, props: { e } }));
}
const { e } = Astro.props;
const u = { ...e, slug: e.base, heroImg: e.imgs[1], logo: e.imgs[3] };
---

<UniversityPage
  u={u}
  tag={`multicampus-${e.base}`}
  back={{ label: '« Volver a The European Experience', href: '/the-european-experience/' }}
  contactHref="/contacto/"
  whyRobin
  canonicalPath={`/universidades/${e.base}/`}
/>
