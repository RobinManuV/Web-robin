---
import '../../styles/pages/destinos.css';
import Base from '../../layouts/Base.astro';
import NewsletterMap from '../../components/NewsletterMap.astro';
import { DESTINOS, LOGOS_HOLANDA } from '../../data/destinos.js';

const title = 'Estudiar en Holanda: 11 ciudades universitarias | Project Robin';
const description =
  'Compara Ámsterdam, Maastricht, Delft, Groningen y 7 ciudades más para estudiar en Holanda: universidades, ambiente y coste real. Guía para familias.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Ciudades para estudiar en Holanda',
    itemListElement: DESTINOS.map((d, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `Estudiar en ${d.name}`,
      url: `https://project-robin.com/destinos/${d.slug}/`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://project-robin.com/' },
      { '@type': 'ListItem', position: 2, name: 'Estudiar en Holanda', item: 'https://project-robin.com/destinos/' },
    ],
  },
];

---

<Base pageClass="page-destinos" title={title} description={description} image="/wp-content/uploads/2026/05/b45b3c027f2f7b146d546b7c9d8fc598.webp" schema={schema}>
  <section class="hero">
    <img class="hero-img" src="/wp-content/uploads/2026/07/estudia-en-holanda-con-project-robin-1.webp" alt="" aria-hidden="true" />
    <div class="hero-inner">
      <p class="eyebrow">Guía de ciudades universitarias</p>
      <h1 class="display-xl">Estudiar en Holanda</h1>
      <p class="lead">
        Una carrera en Holanda cuesta unos 2.700 € de matrícula al año, y vivir allí sale por un precio parecido a mandar a tu hijo a estudiar a
        Madrid desde otra ciudad. Te contamos cómo es de verdad cada ciudad universitaria para que elijáis juntos, con datos y sin rodeos.
      </p>
      <div class="btn-row">
        <a class="btn" href="#reserva-destinos">Reserva tu consulta online</a>
        <a class="btn btn-outline-light" href="/servicios/asesoramiento-completo/">Cómo funciona</a>
      </div>
    </div>
  </section>

  <section class="bg-cream list-section">
    <div class="container">
      <div class="intro center">
        <img class="mill" src="/wp-content/uploads/2026/05/Grupo-162.png" alt="" width="271" height="385" loading="lazy" />
        <p class="eyebrow">Explora las opciones</p>
        <h2 class="display">Ciudades para estudiar en Holanda</h2>
        <p class="text">
          No todas las ciudades universitarias de los Países Bajos son iguales. Cada una tiene sus universidades, su ritmo y su coste de vida. Aquí
          tienes una radiografía directa de las 11 ciudades en las que acompañamos a estudiantes, para ver cuál encaja con el perfil académico de tu
          hijo, su forma de ser y vuestro presupuesto.
        </p>
      </div>

      <ul class="cards">
        {
          DESTINOS.map((d) => (
            <li class="card-d">
              <a class="card-link" href={`/destinos/${d.slug}/`}>
                <div class="card-img">
                  <img src={d.cardImg} alt={`Estudiar en ${d.name}`} loading="lazy" />
                  <h3>{d.name}</h3>
                </div>
                <p class="card-sub">{d.subtitle}</p>
                <p class="card-text">{d.intro}</p>
              </a>
              <a class="btn btn-sm" href={`/destinos/${d.slug}/`}>
                Estudiar en {d.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="cta-band" id="reserva-destinos">
    <p class="eyebrow">Tu próximo gran paso</p>
    <p class="display-md">Diseña la aventura que definirá tu futuro</p>
    <a class="btn" href="/contacto/?origen=holanda">Reserva tu consulta online</a>
  </section>

  <NewsletterMap
    tag="newsletter-holanda"
    mapImg="/wp-content/uploads/2026/07/estudia-en-holanda-con-project-robin-1.webp"
    title="Estudia en Holanda"
    text="Gozamos de una meticulosa selección de destinos para ofrecerte solo lo mejor."
    logos={LOGOS_HOLANDA.slice(0, 6)}
  />
</Base>

