---
import '../../styles/pages/destino.css';
import Base from '../../layouts/Base.astro';
import YouTube from '../../components/YouTube.astro';
import ContactSection from '../../components/ContactSection.astro';
import { DESTINOS } from '../../data/destinos.js';
import { GUIA, GASTOS_BASE, ACTUALIZADO, MATRICULA, DELFT_AERO } from '../../data/destinos-guia.js';

export function getStaticPaths() {
  return DESTINOS.map((d) => ({ params: { slug: d.slug }, props: { d } }));
}

const { d } = Astro.props;
const g = GUIA[d.slug];
const eur = (n) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, '.');
const gastos = g ? [{ label: 'Alquiler de habitación', min: g.alquiler, max: g.alquiler }, ...GASTOS_BASE] : [];
const totalMin = gastos.reduce((a, x) => a + x.min, 0);
const totalMax = gastos.reduce((a, x) => a + x.max, 0);
const otras = DESTINOS.filter((x) => x.slug !== d.slug).sort((a, b) => a.name.localeCompare(b.name, 'es'));
const tag = `holanda-${d.slug}`;
const url = `https://project-robin.com/destinos/${d.slug}/`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://project-robin.com/' },
      { '@type': 'ListItem', position: 2, name: 'Estudiar en Holanda', item: 'https://project-robin.com/destinos/' },
      { '@type': 'ListItem', position: 3, name: `Estudiar en ${d.name}`, item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: d.seoTitle,
    description: d.seoDesc,
    url,
    inLanguage: 'es-ES',
    about: { '@type': 'City', name: d.name, containedInPlace: { '@type': 'Country', name: 'Países Bajos' } },
    isPartOf: { '@id': 'https://project-robin.com/#website' },
    dateModified: ACTUALIZADO.iso,
    ...(g && {
      mentions: g.universidades.map((u) => ({ '@type': 'CollegeOrUniversity', name: u.name, url: u.url })),
    }),
  },
  ...(g
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: g.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
        },
      ]
    : []),
];

const hasFit = d.paraTi.length > 0 || d.noParaTi.length > 0;
---

<Base pageClass="page-destino" title={d.seoTitle} description={d.seoDesc} image={d.heroImg} type="article" schema={schema}>
  <section class="hero container">
    <div class="hero-text">
      <a class="link-back" href="/destinos/">« Volver a Ciudades en Holanda</a>
      <p class="eyebrow sub">{d.subtitle}</p>
      <h1 class="display-xl">{d.name}</h1>
      <p class="lead">{d.intro}</p>
      <div class="btn-row">
        <a class="btn" href="#reserva">Reserva tu consulta online</a>
        <a class="btn btn-outline" href={`/contacto/?origen=pack-llegada-${d.slug}&servicio=Pack%20Llegada`}>Pack Llegada {d.name}</a>
      </div>
    </div>
    <div class="hero-media">
      <figure class="campus">
        <img src="/wp-content/uploads/2026/04/Grupo-251.png" alt={`Campus universitario en ${d.name}`} width="802" height="592" />
        <figcaption>Campus</figcaption>
      </figure>
      <div class="side">
        <figure class="vida">
          <img src="/wp-content/uploads/2026/04/Grupo-254-1024x422.png" alt={`Vida estudiantil en ${d.name}`} width="1024" height="422" loading="lazy" />
          <figcaption>Vida</figcaption>
        </figure>
        {d.video && <YouTube url={d.video} title={`¿Qué tiene ${d.name}?`} />}
      </div>
    </div>
  </section>

  {
    g && (
      <section class="resumen section-sm">
        <div class="container resumen-grid">
          <div class="stack stack--16">
            <p class="eyebrow">En resumen</p>
            <h2 class="display-md">¿Merece la pena estudiar en {d.name}?</h2>
            <p class="lead resumen-text">{g.resumen}</p>
            <p class="small updated">
              Actualizado en <time datetime={ACTUALIZADO.iso}>{ACTUALIZADO.texto}</time>
            </p>
          </div>
          <div>
            <dl class="datos">
              {g.datos.map((x) => (
                <div>
                  <dt>{x.label}</dt>
                  <dd>{x.value}</dd>
                </div>
              ))}
            </dl>
            {g.datosNota && <p class="small nota">{g.datosNota}</p>}
          </div>
        </div>
      </section>
    )
  }

  {
    hasFit && (
      <section class="fit bg-cream">
        <div class="container">
          <p class="eyebrow center">Autoevaluación</p>
          <h2 class="display-md center">¿Es {d.name} tu ciudad?</h2>
          <div class="fit-grid">
            <div class="fit-box">
              <h3>Esta ciudad es para ti si…</h3>
              <ul class="check-list">
                {d.paraTi.map((x) => (
                  <li>{x}</li>
                ))}
              </ul>
            </div>
            <div class="fit-box">
              <h3>Esta ciudad no es para ti si…</h3>
              <ul class="check-list is-cross">
                {d.noParaTi.map((x) => (
                  <li>{x}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>
    )
  }

  {
    g && (
      <>
        <section class="section-sm container" id="universidades">
          <p class="eyebrow">Dónde estudiar</p>
          <h2 class="display-md h2">Universidades en {d.name}</h2>
          <p class="text intro">
            En Holanda hay dos tipos de universidad: las de investigación (WO), más académicas, y las de ciencias aplicadas (HBO), más prácticas y con prácticas en empresa. Estas son las principales opciones en {d.name}:
          </p>
          <div class="unis">
            {g.universidades.map((u) => (
              <article class="uni">
                <p class="uni-type">{u.type}</p>
                <h3>{u.name}</h3>
                <p>{u.text}</p>
                <p class="uni-en">
                  <strong>En inglés:</strong> {u.ingles}
                </p>
                <a href={u.url} target="_blank" rel="noopener">
                  Web oficial →
                </a>
              </article>
            ))}
          </div>
          {g.admisionNota && <p class="aviso">{g.admisionNota}</p>}
        </section>

        {g.promoAero && (
          <section class="section-sm container" id="aeroespaciales">
            <div class="aero">
              <div class="aero-text">
                <p class="eyebrow">Aerospace Engineering</p>
                <h2 class="display-md">¿Pensando en estudiar aeroespaciales?</h2>
                <p class="text">
                  Descubre nuestro pack especializado de preparación de los exámenes de acceso a TU Delft. Las clases las da un profesor exalumno de Delft, en grupos de máximo 5 alumnos y con simulacros del examen real. Y con todo el acompañamiento de Robin incluido.
                </p>
                <a class="btn" href="/servicios/aeroespaciales-delft/">Descubre el pack</a>
              </div>
              <div class="aero-stats">
                <div>
                  <p class="aero-num">≈ {DELFT_AERO.general}</p>
                  <p>tasa de entrada general en Aerospace Engineering</p>
                </div>
                <div class="aero-arrow" aria-hidden="true">→</div>
                <div class="aero-hl">
                  <p class="aero-num">{DELFT_AERO.robin}</p>
                  <p>
                    de nuestros alumnos entra <span class="aero-tag">verificado</span>
                  </p>
                </div>
                <p class="aero-note">{DELFT_AERO.nota[0].toUpperCase() + DELFT_AERO.nota.slice(1)}. Tasa general: unos 3.000 candidatos para 440 plazas (TU Delft, 2026-27).</p>
              </div>
            </div>
          </section>
        )}

        <section class="section-sm bg-sky" id="coste-de-vida">
          <div class="container coste-grid">
            <div class="stack stack--16">
              <p class="eyebrow">Coste de vida</p>
              <h2 class="display-md">¿Cuánto cuesta vivir en {d.name}?</h2>
              <p class="text">
                Calcula entre <strong>{eur(totalMin)} y {eur(totalMax)} € al mes</strong>, sin contar la matrícula. La matrícula para estudiantes de la UE es de <strong>{MATRICULA} al año</strong> en el curso 2026-2027 (tarifa oficial, igual en todas las universidades públicas).
              </p>
              <p class="text">
                Si trabajas al menos 32 horas al mes en Holanda, puedes pedir la beca DUO como un estudiante holandés: en 2026 son hasta 324,52 € al mes de beca básica, más hasta 491,08 € de beca complementaria según los ingresos de tus padres.
              </p>
            </div>
            <table class="gastos">
              <caption class="sr-only">Presupuesto mensual orientativo de un estudiante en {d.name}</caption>
              <thead>
                <tr>
                  <th scope="col">Gasto mensual</th>
                  <th scope="col">Aprox.</th>
                </tr>
              </thead>
              <tbody>
                {gastos.map((x) => (
                  <tr>
                    <th scope="row">{x.label}</th>
                    <td>{x.min === x.max ? `${eur(x.min)} €` : `${eur(x.min)}–${eur(x.max)} €`}</td>
                  </tr>
                ))}
              </tbody>
              <tfoot>
                <tr>
                  <th scope="row">Total</th>
                  <td>
                    {eur(totalMin)}–{eur(totalMax)} €
                  </td>
                </tr>
              </tfoot>
            </table>
          </div>
          <p class="container small nota">
            Alquiler: Kamernet (2025-2026). Si trabajas en Holanda, además tendrás que contratar el seguro de salud holandés (desde unos 150 € al mes, con posible ayuda del gobierno); si no trabajas, te vale la Tarjeta Sanitaria Europea con un seguro complementario.
          </p>
        </section>

        <section class="section-sm container aloja" id="alojamiento">
          <div class="stack stack--16">
            <p class="eyebrow">Alojamiento</p>
            <h2 class="display-md">Encontrar casa en {d.name}</h2>
            <p class="text">{g.alojamiento.text}</p>
            <ul class="check-list">
              {g.alojamiento.tips.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </div>
          <aside class="aloja-robin">
            <p class="badge">Housing garantizado</p>
            <p class="aloja-title">No llegues a {d.name} sin casa</p>
            <p>Con Robin, desde el principio tienes como mínimo una opción de alojamiento asegurada en {d.name}. Hemos vivido en Holanda y sabemos dónde y cómo buscar.</p>
            <a class="btn" href={`/contacto/?origen=pack-llegada-${d.slug}&servicio=Pack%20Llegada`}>
              Pack Llegada {d.name}
            </a>
            <p class="aloja-legal">Garantía de alojamiento: desde el principio del proceso te ofrecemos como mínimo una opción de alojamiento asegurada.</p>
          </aside>
        </section>

        <section class="section-sm bg-cream" id="vida">
          <div class="container">
            <p class="eyebrow">Vida en la ciudad</p>
            <h2 class="display-md h2">Cómo es vivir en {d.name}</h2>
            <p class="text intro">{g.vida.text}</p>
            <div class="vida-grid">
              {g.vida.highlights.map((h) => (
                <article class="vida-card">
                  <h3>{h.title}</h3>
                  <p>{h.text}</p>
                </article>
              ))}
            </div>
          </div>
        </section>

        <section class="section-sm container faq" id="preguntas-frecuentes">
          <p class="eyebrow center">Preguntas frecuentes</p>
          <h2 class="display-md center h2">Estudiar en {d.name}: lo que más nos preguntáis</h2>
          <div class="faq-list">
            {g.faq.map((f, i) => (
              <details open={i === 0}>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </section>

        <nav class="section-sm container otras" aria-label="Otras ciudades de Holanda">
          <p class="eyebrow center">Compara con otras ciudades</p>
          <ul>
            {otras.map((o) => (
              <li>
                <a href={`/destinos/${o.slug}/`}>Estudiar en {o.name}</a>
              </li>
            ))}
          </ul>
        </nav>
      </>
    )
  }

  <div class="bird-wrap bg-cream">
    <img src="/wp-content/uploads/2026/04/Robin-en-Bici.png" alt="" width="724" height="657" loading="lazy" />
  </div>

  <section class="cta">
    <p class="eyebrow">Hazlo real</p>
    <p class="display-md">¿{d.name} suena a tu ciudad?</p>
    <p class="lead">Reserva una primera llamada gratuita. Te decimos si encaja contigo y qué universidad tiene más sentido para tu perfil.</p>
    <a class="btn" href="#reserva">Reserva tu consulta online</a>
  </section>

  <ContactSection tag={tag} />
</Base>

