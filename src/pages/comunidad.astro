---
import '../styles/pages/comunidad.css';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BlogCard from '../components/BlogCard.astro';
import YouTube from '../components/YouTube.astro';
import { TESTIMONIOS, VIDEOS_TESTIMONIOS } from '../data/site.js';
import { PRODUCTOS } from '../data/tienda.js';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => b.data.date - a.data.date).slice(0, 6);
---

<Base pageClass="page-comunidad"
  title="Comunidad de estudiantes internacionales | Project Robin"
  description="Testimonios reales, consejos y recursos de estudiantes internacionales en Europa. Historias sin filtro de quienes ya dieron el paso."
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-text">
        <p class="eyebrow text-accent">Comunidad Robin</p>
        <h1 class="display-md">Bienvenido a la mejor comunidad de estudiantes internacionales en Europa</h1>
        <p class="text">Historias, consejos y recursos para estudiantes internacionales. Aquí encontrarás testimonios reales, inspiración y contenido creado para ayudarte a irte a estudiar fuera sin rodeos.</p>
        <div class="btn-row">
          <a class="btn btn-sm" href="#testimonios">Ver testimonios</a>
          <a class="btn btn-sm btn-outline-light" href="#tienda">Sé un Robin</a>
        </div>
      </div>
      <div class="robins">
        <img class="robins-photo" src="/fotos/comunidad-robins.webp" alt="Dos Robins brindando con las tazas de Robin" width="1920" height="1440" />
        <div class="robins-body">
          <p class="robins-title">Nuestros Robins</p>
          <ul class="tick-list">
            <li>Cómo es realmente irse a estudiar fuera.</li>
            <li>Adaptación, cultura y vida universitaria.</li>
            <li>Dificultades reales… y cómo superarlas.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-cream" id="testimonios">
    <div class="container">
      <p class="eyebrow center">Testimonios</p>
      <h2 class="display-md center section-title">Sin guión, sin filtro</h2>
      <p class="text center section-intro section-intro--wide">Vídeos cortos de nuestros Robins contando qué esperaban, qué se encontraron y qué cambiarían. Desliza para descubrir más historias.</p>
      <div class="shorts" data-shorts>
        <ul class="shorts-track" data-track>
          {
            VIDEOS_TESTIMONIOS.map((url, i) => (
              <li class="short">
                <YouTube url={url} ratio="9 / 16" title={`Testimonio de un Robin (${i + 1})`} />
              </li>
            ))
          }
        </ul>
        <div class="shorts-nav">
          <button type="button" class="shorts-arrow" data-prev aria-label="Vídeos anteriores">←</button>
          <button type="button" class="shorts-arrow" data-next aria-label="Más vídeos">→</button>
        </div>
      </div>
      <div class="t-grid">
        <div class="t-video">
          <YouTube url="https://youtu.be/psjEcd2yAeg" poster="/wp-content/uploads/2026/05/a6f1b0f7b8b6e609fb8387ac02dc8ff3.webp" title="Voces de nuestros Robins" />
        </div>
        {
          TESTIMONIOS.map((t) => (
            <figure class="t-card">
              <img src={t.photo} alt={t.name} width="64" height="64" loading="lazy" />
              <figcaption>
                <strong>{t.name}</strong>
                <span>{t.program}</span>
              </figcaption>
              <blockquote>{t.text}</blockquote>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section container" id="tienda">
    <p class="eyebrow center">Sé un Robin</p>
    <h2 class="display-md center section-title">Viste el estilo Robin</h2>
    <p class="text center section-intro">Nuestra colección exclusiva. Perfecta para estudiantes internacionales que sienten orgullo de formar parte de la comunidad.</p>
    <div class="shop">
      {
        PRODUCTOS.map((p) => (
          <a class="prod" href={`/tienda/${p.slug}/`}>
            <div class="prod-top">
              {p.img ? <img src={p.img} alt={p.name} loading="lazy" width="600" height="600" /> : <span class="prod-soon-art">Coming soon</span>}
              {p.comingSoon && p.img && <span class="prod-badge">Coming soon</span>}
            </div>
            <h3>{p.name}</h3>
            <p class="small">{p.short}</p>
            <div class="prod-foot">
              <strong>{p.price}</strong>
              <span class="btn btn-sm">{p.comingSoon ? 'Ver' : 'Lo quiero →'}</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section bg-cream">
    <div class="container container--blog">
      <p class="eyebrow center">Blog Robin</p>
      <h2 class="display-md center section-title">Lo que nos hubiera gustado leer</h2>
      <p class="text center section-intro">Artículos honestos sobre becas, costes, decisiones, burocracia y vida universitaria. Escritos por gente que ya hizo este camino.</p>
      <div class="blog">{posts.map((p) => <BlogCard post={p} />)}</div>
      <p class="center section-cta"><a class="btn" href="/blog/">Ver todos los artículos</a></p>
    </div>
  </section>
</Base>

<script>
  // Carrusel de vídeos: se desliza con el dedo/trackpad y con las flechas
  document.querySelectorAll('[data-shorts]').forEach((root) => {
    const track = root.querySelector('[data-track]');
    const step = () => (track.firstElementChild?.getBoundingClientRect().width || 260) + 18;
    root.querySelector('[data-prev]').addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    root.querySelector('[data-next]').addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
  });
</script>

