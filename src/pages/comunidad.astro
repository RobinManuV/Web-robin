---
import '../styles/pages/comunidad.css';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BlogCard from '../components/BlogCard.astro';
import YouTube from '../components/YouTube.astro';
import { TESTIMONIOS, VIDEOS_TESTIMONIOS, PARTNERS } from '../data/site.js';
import { PRODUCTOS } from '../data/tienda.js';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => b.data.date - a.data.date).slice(0, 6);
---

<Base pageClass="page-comunidad"
  title="Comunidad de estudiantes internacionales | Project Robin"
  description="Testimonios reales, consejos y recursos de estudiantes internacionales en Europa. Historias sin filtro de quienes ya dieron el paso."
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-text">
        <p class="eyebrow text-accent">Comunidad Robin</p>
        <h1 class="display-md">Bienvenido a la mejor comunidad de estudiantes internacionales en Europa</h1>
        <p class="text">Historias, consejos y recursos para ti. Aquí encontrarás testimonios reales de estudiantes que ya están allí y contenido creado para ayudarte a irte a estudiar fuera sin rodeos.</p>
        <div class="btn-row">
          <a class="btn btn-sm" href="#testimonios">Ver testimonios</a>
          <a class="btn btn-sm btn-outline-light" href="#tienda">Sé un Robin</a>
        </div>
      </div>
      <div class="robins">
        <img class="robins-photo" src="/fotos/comunidad-robins.webp" alt="Dos Robins brindando con las tazas de Robin" width="1920" height="1440" />
        <div class="robins-body">
          <p class="robins-title">Nuestros Robins</p>
          <ul class="tick-list">
            <li>Cómo es realmente irse a estudiar fuera.</li>
            <li>Adaptación, cultura y vida universitaria.</li>
            <li>Dificultades reales… y cómo superarlas.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-cream" id="testimonios">
    <div class="container">
      <p class="eyebrow center">Testimonios</p>
      <h2 class="display-md center section-title">Sin guión, sin filtro</h2>
      <p class="text center section-intro section-intro--wide">Vídeos cortos de nuestros Robins contando qué esperaban, qué se encontraron y qué cambiarían. Desliza para descubrir más historias.</p>
      <div class="shorts" data-shorts>
        <ul class="shorts-track" data-track>
          {
            VIDEOS_TESTIMONIOS.map((url, i) => (
              <li class="short">
                <YouTube url={url} ratio="9 / 16" title={`Testimonio de un Robin (${i + 1})`} />
              </li>
            ))
          }
        </ul>
        <div class="shorts-nav">
          <button type="button" class="shorts-arrow" data-prev aria-label="Vídeos anteriores">←</button>
          <button type="button" class="shorts-arrow" data-next aria-label="Más vídeos">→</button>
        </div>
      </div>
    </div>
  </section>

  <section class="section partners" id="partners">
    <div class="container">
      <p class="eyebrow center">Partners</p>
      <h2 class="display-md center section-title">Nuestros partners para hacer tu experiencia inolvidable</h2>
    </div>
    <!-- Se mueve solo; también se puede arrastrar con el ratón o deslizar con el dedo -->
    <div class="partners-belt" data-belt>
      <div class="partners-track">
        {
          [0, 1].map((copy) => (
            <ul class="partners-list" aria-hidden={copy === 1 ? 'true' : undefined}>
              {PARTNERS.map((p) => (
                <li>
                  <a
                    class="partner"
                    href={p.url}
                    target="_blank"
                    rel="noopener"
                    tabindex={copy === 1 ? -1 : undefined}
                    data-aviso={p.codigo ? p.slug : undefined}
                    draggable="false"
                  >
                    <span class="partner-logo">
                      {p.logo ? <img src={p.logo} alt={copy === 1 ? '' : `Logo de ${p.name}`} loading="lazy" draggable="false" /> : <span class="partner-wordmark">{p.name}</span>}
                    </span>
                    <span class="partner-name">{p.name}</span>
                  </a>
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
    {
      PARTNERS.filter((p) => p.codigo).map((p) => (
        <dialog class="aviso" id={`aviso-${p.slug}`} aria-labelledby={`aviso-${p.slug}-t`}>
          <button type="button" class="aviso-close" data-close aria-label="Cerrar">×</button>
          <p class="aviso-title" id={`aviso-${p.slug}-t`}>¡Recuerda!</p>
          <p class="aviso-text">
            Con el código <strong class="aviso-code">{p.codigo}</strong> {p.aviso}
          </p>
          <div class="aviso-actions">
            <button type="button" class="btn btn-outline" data-copy={p.codigo}>Copiar código</button>
            <a class="btn" href={p.url} target="_blank" rel="noopener" data-close>Ir a {p.name}</a>
          </div>
        </dialog>
      ))
    }
  </section>

  <section class="section bg-cream">
    <div class="container">
      <div class="t-grid">
        <div class="t-video">
          <YouTube url="https://youtu.be/-2wYugmzzTk" poster="/wp-content/uploads/2026/05/a6f1b0f7b8b6e609fb8387ac02dc8ff3.webp" title="Voces de nuestros Robins" />
        </div>
        {
          TESTIMONIOS.map((t) => (
            <figure class="t-card">
              <img src={t.photo} alt={t.name} width="64" height="64" loading="lazy" />
              <figcaption>
                <strong>{t.name}</strong>
                <span>{t.program}</span>
              </figcaption>
              <blockquote>{t.text}</blockquote>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section container" id="tienda">
    <p class="eyebrow center">Sé un Robin</p>
    <h2 class="display-md center section-title">Viste el estilo Robin</h2>
    <p class="text center section-intro">Nuestra colección exclusiva. Perfecta para estudiantes internacionales que sienten orgullo de formar parte de la comunidad.</p>
    <div class="shop">
      {
        PRODUCTOS.map((p) => (
          <a class="prod" href={`/tienda/${p.slug}/`}>
            <div class="prod-top">
              {p.img ? <img src={p.img} alt={p.name} loading="lazy" width="600" height="600" /> : <span class="prod-soon-art">Coming soon</span>}
              {p.comingSoon && p.img && <span class="prod-badge">Coming soon</span>}
            </div>
            <h3>{p.name}</h3>
            <p class="small">{p.short}</p>
            <div class="prod-foot">
              <strong>{p.price}</strong>
              <span class="btn btn-sm">{p.comingSoon ? 'Ver' : 'Lo quiero →'}</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section bg-cream">
    <div class="container container--blog">
      <p class="eyebrow center">Blog Robin</p>
      <h2 class="display-md center section-title">Lo que nos hubiera gustado leer</h2>
      <p class="text center section-intro">Artículos honestos sobre becas, costes, decisiones, burocracia y vida universitaria. Escritos por gente que ya hizo este camino.</p>
      <div class="blog">{posts.map((p) => <BlogCard post={p} />)}</div>
      <p class="center section-cta"><a class="btn" href="/blog/">Ver todos los artículos</a></p>
    </div>
  </section>
</Base>

<script>
  import { pick } from '../i18n/runtime.js';

  // Cinturón de partners: avanza solo de derecha a izquierda y también se puede mover a mano
  // (arrastrando con el ratón, con el trackpad o deslizando con el dedo). La lista va duplicada:
  // al pasar la mitad se vuelve atrás exactamente una lista y el salto no se nota.
  document.querySelectorAll('[data-belt]').forEach((belt) => {
    const track = belt.firstElementChild;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const SPEED = 40; // px por segundo
    let pos = 0;
    let last = performance.now();
    let resumeAt = 0;
    let hover = false;
    let drag = null;
    let moved = false;

    const half = () => track.scrollWidth / 2;
    const wrap = (x) => {
      const h = half();
      return h ? ((x % h) + h) % h : 0;
    };
    const setPos = (x) => {
      pos = wrap(x);
      belt.scrollLeft = pos;
    };
    const hold = (ms = 2500) => (resumeAt = performance.now() + ms);

    const tick = (t) => {
      const dt = Math.min(64, t - last);
      last = t;
      if (!reduce && !hover && !drag && t > resumeAt) setPos(pos + (SPEED * dt) / 1000);
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);

    // Scroll del usuario (dedo, trackpad, rueda horizontal)
    belt.addEventListener(
      'scroll',
      () => {
        if (drag || Math.abs(belt.scrollLeft - pos) < 2) return;
        hold();
        const x = belt.scrollLeft;
        if (x <= 0 || x >= half()) setPos(x);
        else pos = x;
      },
      { passive: true },
    );
    belt.addEventListener('touchstart', () => hold(), { passive: true });

    // Arrastrar con el ratón
    belt.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && (hover = true));
    belt.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && (hover = false));
    belt.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      drag = { x: e.clientX, start: pos };
      moved = false;
    });
    window.addEventListener('pointermove', (e) => {
      if (!drag) return;
      const dx = e.clientX - drag.x;
      if (Math.abs(dx) > 4 && !moved) {
        moved = true;
        belt.classList.add('is-dragging');
      }
      if (moved) setPos(drag.start - dx);
    });
    window.addEventListener('pointerup', () => {
      if (!drag) return;
      drag = null;
      belt.classList.remove('is-dragging');
      hold(1500);
    });
    // Si se ha arrastrado, soltar no abre el enlace
    belt.addEventListener(
      'click',
      (e) => {
        if (moved) {
          e.preventDefault();
          e.stopPropagation();
          moved = false;
        }
      },
      true,
    );
  });

  // Aviso antes de ir a un partner con código de descuento (p. ej. Swapfiets)
  const txt = pick({
    es: { copied: '¡Copiado!', copy: 'Copiar código' },
    en: { copied: 'Copied!', copy: 'Copy code' },
    pt: { copied: 'Copiado!', copy: 'Copiar código' },
  });
  document.querySelectorAll('[data-aviso]').forEach((a) => {
    a.addEventListener('click', (e) => {
      const dlg = document.getElementById(`aviso-${a.dataset.aviso}`);
      if (!dlg || typeof dlg.showModal !== 'function') return; // navegador antiguo: abre el enlace sin más
      e.preventDefault();
      dlg.showModal();
    });
  });
  document.querySelectorAll('dialog.aviso').forEach((dlg) => {
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg || e.target.closest('[data-close]')) dlg.close();
    });
    const copy = dlg.querySelector('[data-copy]');
    copy?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copy.dataset.copy);
        copy.textContent = txt.copied;
        setTimeout(() => (copy.textContent = txt.copy), 2000);
      } catch {}
    });
  });

  // Carrusel de vídeos: se desliza con el dedo/trackpad y con las flechas
  document.querySelectorAll('[data-shorts]').forEach((root) => {
    const track = root.querySelector('[data-track]');
    const step = () => (track.firstElementChild?.getBoundingClientRect().width || 260) + 18;
    root.querySelector('[data-prev]').addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    root.querySelector('[data-next]').addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
  });
</script>

