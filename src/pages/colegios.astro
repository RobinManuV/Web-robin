---
import '../styles/pages/colegios.css';
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import { CONTACT, RECOMENDADOR } from '../data/site.js';

// Solo los colegios con nombre real. Los "Colegio 1, 2…" de la web antigua eran huecos de relleno.
const colegios = [
  'Colegio International de Torrequebrada',
  'Colegio Voramar',
  'Nuestra Señora del Carmen',
  'IES Jorge Manrique de Palencia',
  'Colegio Británico de Barranquilla',
  'Albaydar, Sevilla',
  'Irlandesas de Bami, Sevilla',
  'Díaz Balaguer, Madrid',
  "King's College, Alicante",
  'Colegio El Buen Pastor, Sevilla',
];
const pasos = [
  { t: 'Kick-off', d: 'Reunión con orientación para adaptar contenidos a vuestro perfil de alumnos.', img: '/fotos/colegios-5.webp', alt: 'Stand de Project Robin en un colegio' },
  { t: 'Charlas', d: 'Sesiones para alumnos y para familias — presencial o online.', img: '/fotos/colegios-3.webp', alt: 'Charla de Robin ante un auditorio de alumnos de Bachillerato' },
  { t: 'Tutorías', d: '1:1 con los alumnos interesados. Plan individual de candidatura.', img: '/fotos/colegios-2.webp', alt: 'Alumnas hablando con un mentor de Robin' },
  { t: 'Seguimiento', d: 'Reporte anual al colegio. Resultados medibles (admisiones, ciudades, becas).', img: '/fotos/colegios-4.webp', alt: 'Sesión de Robin con un grupo de alumnos' },
];
// Cabina "Así funciona el recomendador" (debajo de "Así trabajamos con tu colegio"): 4 fases con el
// lenguaje visual del recomendador (Robin Airlines). Se resume la presentación «How the degree recommender works».
const recFases = ['Embarque', 'Ruta', 'Instrumentos', 'Aterrizaje'];
const recPasos = [
  { code: 'CHK · 01', t: 'Check-in', d: 'El alumno entra con sus datos y su colegio.' },
  { code: 'RTE · 02', t: 'Elige rumbo', d: 'Una de las siete grandes áreas de estudio.' },
  { code: 'FLT · 03', t: 'En vuelo', d: 'Responde sobre su perfil académico, lo que le gusta y sus planes.' },
  { code: 'LND · 04', t: 'Aterriza', d: 'Tres recomendaciones personales de grados reales.' },
];
const recRuta = 'M 40 96 C 220 96, 260 40, 380 40 S 640 22, 700 30 S 860 80, 920 96';
const recWaypoints = [[40, 96], [380, 40], [700, 30], [920, 96]];
// Relojes de "Instrumentos" (decorativos: no muestran datos). Marcas calculadas aquí para no generarlas en el navegador.
const recTicks = Array.from({ length: 21 }, (_, k) => {
  const a = ((-225 + k * 13.5) * Math.PI) / 180;
  const major = k % 5 === 0;
  const r1 = major ? 50 : 55;
  const f = (n) => Math.round(n * 10) / 10;
  return { major, x1: f(75 + r1 * Math.cos(a)), y1: f(75 + r1 * Math.sin(a)), x2: f(75 + 61 * Math.cos(a)), y2: f(75 + 61 * Math.sin(a)) };
});
const recArc = `M ${(75 + 44 * Math.cos(-Math.PI / 4)).toFixed(1)} ${(75 + 44 * Math.sin(-Math.PI / 4)).toFixed(1)} A 44 44 0 0 1 ${(75 + 44 * Math.cos(Math.PI / 4)).toFixed(1)} ${(75 + 44 * Math.sin(Math.PI / 4)).toFixed(1)}`;
const recSenales = [
  { t: 'Expediente', d: 'Sistema educativo, notas y asignaturas que cursa.', to: 62 },
  { t: 'Intereses', d: 'Área elegida, asignaturas favoritas y países que le atraen.', to: 88 },
  { t: 'Preferencias', d: 'Cómo le gusta aprender, ciudad, presupuesto y prioridades.', to: 74 },
  { t: 'Sus palabras', d: 'Qué quiere ser y qué espera de la universidad.', to: 104 },
];
const recResultado = ['Grado y universidad', '% de compatibilidad', 'Por qué le encaja', 'Sus puntos fuertes', 'Web oficial del grado'];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Orientación universitaria internacional para colegios',
  provider: { '@id': 'https://project-robin.com/#organization' },
  audience: { '@type': 'EducationalAudience', educationalRole: 'school' },
  areaServed: 'ES',
  description: 'Charlas, talleres y tutorías 1:1 de orientación universitaria internacional para alumnos de Bachillerato y sus familias.',
};
---

<Base pageClass="page-colegios"
  title="Orientación universitaria para colegios | Project Robin"
  description="Charlas, talleres y tutorías 1:1 de orientación universitaria internacional para alumnos de Bachillerato y sus familias. Partner oficial de tu colegio."
  schema={schema}
>
  <section class="hero bg-navy">
    <div class="container hero-grid">
      <div class="hero-text">
        <p class="eyebrow text-accent">Colegios Robin</p>
        <h1 class="display-xl">Partner oficial de tu colegio</h1>
        <p class="text">Acompañamos a los alumnos de Bachillerato en la decisión más importante de su vida académica. Charlas, talleres y tutorías 1:1 — a los padres también.</p>
        <ul class="tick-list">
          <li>Orientación universitaria internacional sin sesgos comerciales.</li>
          <li>Alineado con el Bachillerato (nacional, IB, A-Levels, Abitur).</li>
          <li>Sesiones para alumnos y para familias.</li>
        </ul>
        <div class="btn-row">
          <a class="btn" href="#formulario-colegios">Contactar para mi colegio</a>
          <a class="btn btn-outline-light" href={RECOMENDADOR.adminUrl} target="_blank" rel="noopener">Accede al Recomendador</a>
        </div>
      </div>
      <img class="hero-photo" src="/fotos/colegios-1.webp" alt="Charla de orientación universitaria de Robin en un aula de Bachillerato" width="1600" height="1200" />
    </div>
  </section>

  <section class="section container center">
    <p class="eyebrow">Método Robin</p>
    <h2 class="display-md section-title">Así trabajamos con tu colegio</h2>
    <p class="text">Un calendario claro, sesiones acotadas y entregables concretos. Cero ruido extra para el equipo docente.</p>
    <ol class="pasos">
      {
        pasos.map((p, i) => (
          <li>
            <img class="paso-img" src={p.img} alt={p.alt} loading="lazy" width="600" height="750" />
            <span class="n">{i + 1}</span>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- RECOMENDADOR: cabina con 4 fases (embarque, ruta, instrumentos, aterrizaje) -->
  <section class="section rec" id="recomendador">
    <div class="container rec-wrap">
      <p class="eyebrow center">Recomendador Robin · RB 2027</p>
      <h2 class="display-md center section-title">Así funciona el recomendador</h2>

      <div class="cab" data-cab>
        <a class="cab-notch" href={RECOMENDADOR.colegiosUrl} target="_blank" rel="noopener"><span class="cab-notch-lamp" aria-hidden="true"></span>Solicita tu acceso</a>
        <span class="cab-screw tl"></span><span class="cab-screw tr"></span><span class="cab-screw bl"></span><span class="cab-screw br"></span>
        <div class="cab-screen">
          <div class="cab-annun">
            <span class="cab-id">Robin Airlines · <b>Panel de vuelo</b></span>
            <ol class="cab-phases" aria-label="Fases">
              {
                recFases.map((f, k) => (
                  <li>
                    <button type="button" class="cab-phase" data-go={k}>
                      <span class="cab-lamp" />
                      <span class="cab-txt">{f}</span>
                      <span class="cab-num">0{k + 1}</span>
                    </button>
                  </li>
                ))
              }
            </ol>
            <span class="cab-count">Fase <b data-count>1</b>/4</span>
          </div>

          <div class="cab-stage" data-stage aria-live="polite">
            <!-- 1 · EMBARQUE: qué es -->
            <article class="cab-panel is-on" data-panel>
              <div class="cab-board">
                <div class="cab-board-text">
                  <p class="cab-kicker">01 · Embarque · Qué es</p>
                  <h3 class="cab-title">Una clase, una sesión y cada alumno con sus propios grados.</h3>
                  <p class="cab-p">Todos responden a la vez: sus notas, lo que les gusta y lo que quieren hacer en el futuro. En unos minutos, cada uno recibe los grados reales que mejor encajan con él, con el porqué explicado.</p>
                  <p class="cab-p">Y tú lo tienes todo <b>bajo control desde tu panel</b>: qué ha respondido cada alumno, qué busca y qué recomendaciones le han convencido y cuáles no. Así ves dónde acierta el recomendador y qué piensa cada uno.</p>
                </div>
                <div class="cab-pass" aria-hidden="true">
                  <div class="cab-pass-top"><b>ROBIN AIRLINES</b><span>Tarjeta de embarque de grupo</span></div>
                  <div class="cab-pass-body">
                    <div class="cab-route">
                      <div><strong>CLASE</strong><small>Tu colegio</small></div>
                      <div class="cab-dash"></div>
                      <div class="cab-route-end"><strong>UNI</strong><small>Sus grados</small></div>
                    </div>
                    <div class="cab-fields">
                      <div><span>Vuelo</span><b>RB 2027</b></div>
                      <div><span>Pasajeros</span><b>Toda la clase</b></div>
                      <div><span>Duración</span><b>Una sesión</b></div>
                      <div><span>Destino</span><b>3 grados / alumno</b></div>
                      <div><span>Comandante</span><b>Orientador</b></div>
                      <div><span>Control</span><b>Tu panel</b></div>
                    </div>
                  </div>
                  <div class="cab-pass-foot"><span class="cab-barcode"></span><small>Puerta R · Embarque en grupo</small></div>
                </div>
              </div>
            </article>

            <!-- 2 · RUTA: cómo lo usa el alumno -->
            <article class="cab-panel" data-panel aria-hidden="true">
              <p class="cab-kicker">02 · Ruta · Cómo lo usa el alumno</p>
              <h3 class="cab-title">Cuatro pasos, unos minutos</h3>
              <div class="cab-flight" data-flight>
                <svg viewBox="0 0 1000 120" preserveAspectRatio="none" aria-hidden="true">
                  <path class="cab-track" d={recRuta} />
                  <path class="cab-flown" d={recRuta} data-flown />
                  {recWaypoints.map(([x, y]) => <circle class="cab-wp" cx={x} cy={y} r="7" />)}
                </svg>
                <img class="cab-plane" src="/fotos/recomendador-avion.webp" alt="" width="470" height="260" loading="lazy" data-plane />
              </div>
              <ol class="cab-steps">
                {
                  recPasos.map((p) => (
                    <li>
                      <span class="cab-code">{p.code}</span>
                      <b>{p.t}</b>
                      <span>{p.d}</span>
                    </li>
                  ))
                }
              </ol>
              <p class="cab-caution"><i>Grupo</i>Toda la clase lo hace a la vez, en la misma sesión. Las preguntas se adaptan al área que elige cada alumno.</p>
            </article>

            <!-- 3 · INSTRUMENTOS: qué tiene en cuenta -->
            <article class="cab-panel" data-panel aria-hidden="true">
              <p class="cab-kicker">03 · Instrumentos · Qué tiene en cuenta</p>
              <h3 class="cab-title">Todo el perfil del alumno, no solo sus notas</h3>
              <ul class="cab-gauges">
                {
                  recSenales.map((g) => (
                    <li class="cab-gauge">
                      <svg viewBox="0 0 150 150" aria-hidden="true">
                        <circle class="cab-face" cx="75" cy="75" r="66" />
                        {recTicks.map((t) => <line class:list={['cab-tick', { major: t.major }]} x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} />)}
                        <path class="cab-arc" d={recArc} />
                        <line class="cab-needle" x1="75" y1="75" x2="75" y2="22" data-needle={g.to} />
                        <circle class="cab-hub" cx="75" cy="75" r="6" />
                      </svg>
                      <b>{g.t}</b>
                      <span>{g.d}</span>
                    </li>
                  ))
                }
              </ul>
              <p class="cab-caution"><i>Nota</i>Lo que escribe con sus palabras suma cuando aporta algo concreto, pero nunca sustituye al resto del perfil.</p>
            </article>

            <!-- 4 · ATERRIZAJE: qué obtenéis -->
            <article class="cab-panel" data-panel aria-hidden="true">
              <p class="cab-kicker">04 · Aterrizaje · Qué obtenéis</p>
              <h3 class="cab-title">Recomendaciones claras y explicadas</h3>
              <div class="cab-arr">
                <div class="cab-arrivals" role="table" aria-label="Lo que incluye cada recomendación">
                  <div class="cab-arr-h" role="row"><span role="columnheader">Nº</span><span role="columnheader">Llegadas · Cada grado incluye</span><span role="columnheader">Estado</span></div>
                  {
                    recResultado.map((r, k) => (
                      <div class="cab-arr-r" role="row">
                        <span class="n" role="cell">0{k + 1}</span>
                        <span role="cell" data-flap-row>{r}</span>
                        <span class="st" role="cell">En panel</span>
                      </div>
                    ))
                  }
                </div>
                <div class="cab-arr-side">
                  <p class="cab-p">El alumno ve sus tres grados y marca si le convencen. Tú lo ves todo en tu panel, alumno por alumno.</p>
                  <p class="cab-caution"><i>Aviso</i>Solo recomienda grados que existen de verdad. Es una orientación, no una decisión de admisión: los requisitos dependen de cada grado.</p>
                </div>
              </div>
            </article>
          </div>
        </div>

        <div class="cab-controls">
          <button type="button" class="cab-key" data-prev aria-label="Fase anterior">←</button>
          <div class="cab-alt" aria-hidden="true"><div class="cab-alt-fill" data-alt></div></div>
          <button type="button" class="cab-key" data-next aria-label="Fase siguiente">→</button>
        </div>
      </div>

      <p class="rec-cta">
        <a class="cab-cta" href={RECOMENDADOR.colegiosUrl} target="_blank" rel="noopener">Solicitar acceso <span aria-hidden="true">→</span></a>
        <span class="rec-cta-note">Para colegios y orientadores</span>
      </p>
    </div>
  </section>

  <section class="section-sm bg-cream">
    <div class="container center">
      <p class="eyebrow">Colegios Robin</p>
      <h2 class="display-md section-title">Centros que ya confían en nosotros</h2>
      <p class="text">Colegios e institutos en España y LATAM que colaboran con Robin para orientar a sus alumnos hacia universidades europeas.</p>
      <ul class="cols">
        {colegios.map((c) => <li>{c}</li>)}
        <li class="next">+ Tu cole pronto</li>
      </ul>
    </div>
  </section>

  <section class="bg-navy talk" id="formulario-colegios">
    <div class="container talk-grid">
      <div>
        <p class="eyebrow text-accent">Para el colegio</p>
        <h2 class="display-md">¿Hablamos?</h2>
        <p class="text">Diseñamos el plan específico para vuestro centro. Primera reunión sin coste — presencial en Madrid o online.</p>
        <p class="lbl">Email colegios</p>
        <p><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></p>
        <p class="lbl">Teléfono directo</p>
        <p><a href={`tel:${CONTACT.phone.replace(/\s/g, '')}`}>{CONTACT.phone}</a></p>
      </div>
      <div class="form-card">
        <h3>Formulario colegios</h3>
        <p class="small">Respondemos en menos de 24h laborables.</p>
        <LeadForm form="colegios" tag="colegios" submitLabel="Enviar solicitud" />
      </div>
    </div>
  </section>
</Base>

<script>
  // Cabina del recomendador: 4 fases. Se cambia con las luces de fase, las flechas, el teclado o deslizando.
  // Al entrar en cada fase: título tipo panel de aeropuerto, avioneta que recorre la ruta, agujas que se mueven
  // y panel de llegadas. Sin animaciones si el usuario las tiene desactivadas.
  document.querySelectorAll('[data-cab]').forEach((root) => {
    const panels = [...root.querySelectorAll('[data-panel]')];
    const btns = [...root.querySelectorAll('[data-go]')];
    const prev = root.querySelector('[data-prev]');
    const next = root.querySelector('[data-next]');
    const alt = root.querySelector('[data-alt]');
    const count = root.querySelector('[data-count]');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0;

    // Letras que giran hasta quedarse quietas (split-flap), solo en el panel de llegadas (letra de ancho fijo,
    // así no se mueve nada alrededor). Se actualiza cada ~50 ms, no en cada fotograma, para que no pese.
    const CH = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
    const flap = (el, delay = 0) => {
      if (reduce) return;
      const final = el.dataset.final ?? (el.dataset.final = el.textContent);
      const start = performance.now() + delay;
      const settle = [...final].map((_, k) => 120 + k * 18 + Math.random() * 140);
      let last = 0;
      const step = (t) => {
        const e = t - start;
        if (e < 0 || t - last < 50) return requestAnimationFrame(step);
        last = t;
        let done = true;
        let out = '';
        for (let k = 0; k < final.length; k++) {
          const c = final[k];
          if (c === ' ' || e >= settle[k]) out += c;
          else {
            done = false;
            out += CH[(Math.random() * CH.length) | 0];
          }
        }
        el.textContent = out;
        if (!done) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    // Agujas de los relojes
    const needles = [...root.querySelectorAll('[data-needle]')];
    const setNeedles = (on) =>
      needles.forEach((n, k) => {
        n.style.transitionDelay = on ? `${k * 140}ms` : '0ms';
        n.style.transform = `rotate(${on ? n.dataset.needle : -135}deg)`;
      });
    setNeedles(false);

    // Avioneta sobre la ruta
    const flight = root.querySelector('[data-flight]');
    const svg = flight.querySelector('svg');
    const flown = flight.querySelector('[data-flown]');
    const plane = flight.querySelector('[data-plane]');
    const wps = [...flight.querySelectorAll('.cab-wp')];
    const wpAt = [0, 0.36, 0.7, 1];
    const L = flown.getTotalLength();
    flown.style.strokeDasharray = `${L}`;
    let flyRaf = 0;
    let flyP = 0;
    // Tamaño de la ruta en pantalla: se lee solo al cambiar de tamaño, no en cada fotograma
    let box = { w: 0, h: 0 };
    const lit = wps.map(() => false);
    const placePlane = (p) => {
      flyP = p;
      if (!box.w) return;
      const pt = flown.getPointAtLength(L * p);
      const pt2 = flown.getPointAtLength(Math.min(L, L * p + 4));
      const sx = box.w / 1000;
      const sy = box.h / 120;
      const ang = (Math.atan2((pt2.y - pt.y) * sy, (pt2.x - pt.x) * sx) * 180) / Math.PI;
      // Solo transform (sin left/top): el navegador no tiene que recolocar la página en cada fotograma.
      // La imagen mira a la izquierda: scaleX(-1) la voltea para que vuele hacia la derecha.
      plane.style.transform = `translate(${pt.x * sx}px, ${pt.y * sy}px) translate(-50%, -62%) rotate(${ang * 0.6}deg) scaleX(-1)`;
      flown.style.strokeDashoffset = `${L * (1 - p)}`;
      wps.forEach((w, k) => {
        const on = p >= wpAt[k] - 0.001;
        if (on !== lit[k]) w.classList.toggle('lit', (lit[k] = on));
      });
    };
    const fly = () => {
      cancelAnimationFrame(flyRaf);
      if (reduce) return placePlane(1);
      const s0 = performance.now();
      const D = 4200;
      const step = (t) => {
        const x = Math.min(1, (t - s0) / D);
        placePlane(0.5 - Math.cos(Math.PI * x) / 2);
        if (x < 1) flyRaf = requestAnimationFrame(step);
      };
      placePlane(0);
      flyRaf = requestAnimationFrame(step);
    };
    new ResizeObserver(([e]) => {
      box = { w: e.contentRect.width, h: e.contentRect.height };
      placePlane(flyP);
    }).observe(svg);

    const go = (n) => {
      i = Math.max(0, Math.min(panels.length - 1, n));
      panels.forEach((p, k) => {
        p.classList.toggle('is-on', k === i);
        p.setAttribute('aria-hidden', k === i ? 'false' : 'true');
      });
      btns.forEach((b, k) => {
        if (k === i) b.setAttribute('aria-current', 'step');
        else b.removeAttribute('aria-current');
        b.classList.toggle('done', k < i);
      });
      count.textContent = String(i + 1);
      prev.disabled = i === 0;
      next.disabled = i === panels.length - 1;
      alt.style.width = `${(i / (panels.length - 1)) * 100}%`;
      setNeedles(i === 2);
      if (i === 1) fly();
      if (i === 3) panels[3].querySelectorAll('[data-flap-row]').forEach((el, k) => flap(el, 250 + k * 160));
    };

    prev.addEventListener('click', () => go(i - 1));
    next.addEventListener('click', () => go(i + 1));
    btns.forEach((b, k) => b.addEventListener('click', () => go(k)));
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') go(i + 1);
      if (e.key === 'ArrowLeft') go(i - 1);
    });
    const stage = root.querySelector('[data-stage]');
    let sx = null;
    stage.addEventListener('touchstart', (e) => (sx = e.touches[0].clientX), { passive: true });
    stage.addEventListener('touchend', (e) => {
      if (sx == null) return;
      const dx = e.changedTouches[0].clientX - sx;
      sx = null;
      if (Math.abs(dx) > 50) go(i + (dx < 0 ? 1 : -1));
    });
    go(0);
  });
</script>

