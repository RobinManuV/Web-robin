---
import '../styles/pages/colegios.css';
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import { CONTACT, RECOMENDADOR } from '../data/site.js';

// Solo los colegios con nombre real. Los "Colegio 1, 2…" de la web antigua eran huecos de relleno.
const colegios = [
  'Colegio International de Torrequebrada',
  'Colegio Voramar',
  'Nuestra Señora del Carmen',
  'IES Jorge Manrique de Palencia',
  'Colegio Británico de Barranquilla',
  'Albaydar, Sevilla',
  'Irlandesas de Bami, Sevilla',
  'Díaz Balaguer, Madrid',
];
const pasos = [
  { t: 'Kick-off', d: 'Reunión con orientación para adaptar contenidos a vuestro perfil de alumnos.', img: '/fotos/colegios-5.webp', alt: 'Stand de Project Robin en un colegio' },
  { t: 'Charlas', d: 'Sesiones para alumnos y para familias — presencial o online.', img: '/fotos/colegios-3.webp', alt: 'Charla de Robin ante un auditorio de alumnos de Bachillerato' },
  { t: 'Tutorías', d: '1:1 con los alumnos interesados. Plan individual de candidatura.', img: '/fotos/colegios-2.webp', alt: 'Alumnas hablando con un mentor de Robin' },
  { t: 'Seguimiento', d: 'Reporte anual al colegio. Resultados medibles (admisiones, ciudades, becas).', img: '/fotos/colegios-4.webp', alt: 'Sesión de Robin con un grupo de alumnos' },
];
// Carrusel "Así funciona el recomendador" (debajo de "Así trabajamos con tu colegio").
// Resumen sencillo de la presentación «How the degree recommender works»: máximo 4 diapositivas.
const recPasos = [
  { t: 'Se registra', d: 'El alumno entra con sus datos y su colegio.' },
  { t: 'Elige un área', d: 'Una de las siete grandes áreas de estudio.' },
  { t: 'Responde', d: 'Su perfil académico, lo que le gusta y lo que quiere hacer en el futuro.' },
  { t: 'Recibe sus grados', d: 'Tres recomendaciones personales de grados reales.' },
];
const recSenales = [
  { t: 'Expediente académico', d: 'Sistema educativo, notas y asignaturas que cursa.' },
  { t: 'Intereses', d: 'Área elegida, asignaturas favoritas y países que le atraen.' },
  { t: 'Preferencias', d: 'Cómo le gusta aprender, ciudad, presupuesto y prioridades.' },
  { t: 'Sus propias palabras', d: 'Qué quiere ser y qué espera de la universidad.' },
];
const recResultado = ['Grado y universidad', 'Porcentaje de compatibilidad', 'Por qué le encaja', 'Sus puntos fuertes', 'Enlace a la web oficial del grado'];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Orientación universitaria internacional para colegios',
  provider: { '@id': 'https://project-robin.com/#organization' },
  audience: { '@type': 'EducationalAudience', educationalRole: 'school' },
  areaServed: 'ES',
  description: 'Charlas, talleres y tutorías 1:1 de orientación universitaria internacional para alumnos de Bachillerato y sus familias.',
};
---

<Base pageClass="page-colegios"
  title="Orientación universitaria para colegios | Project Robin"
  description="Charlas, talleres y tutorías 1:1 de orientación universitaria internacional para alumnos de Bachillerato y sus familias. Partner oficial de tu colegio."
  schema={schema}
>
  <section class="hero bg-navy">
    <div class="container hero-grid">
      <div class="hero-text">
        <p class="eyebrow text-accent">Colegios Robin</p>
        <h1 class="display-xl">Partner oficial de tu colegio</h1>
        <p class="text">Acompañamos a los alumnos de Bachillerato en la decisión más importante de su vida académica. Charlas, talleres y tutorías 1:1 — a los padres también.</p>
        <ul class="tick-list">
          <li>Orientación universitaria internacional sin sesgos comerciales.</li>
          <li>Alineado con el Bachillerato (nacional, IB, A-Levels, Abitur).</li>
          <li>Sesiones para alumnos y para familias.</li>
        </ul>
        <div class="btn-row">
          <a class="btn" href="#formulario-colegios">Contactar para mi colegio</a>
          <a class="btn btn-outline-light" href={RECOMENDADOR.adminUrl} target="_blank" rel="noopener">Accede al Recomendador</a>
        </div>
      </div>
      <img class="hero-photo" src="/fotos/colegios-1.webp" alt="Charla de orientación universitaria de Robin en un aula de Bachillerato" width="1600" height="1200" />
    </div>
  </section>

  <section class="section container center">
    <p class="eyebrow">Método Robin</p>
    <h2 class="display-md section-title">Así trabajamos con tu colegio</h2>
    <p class="text">Un calendario claro, sesiones acotadas y entregables concretos. Cero ruido extra para el equipo docente.</p>
    <ol class="pasos">
      {
        pasos.map((p, i) => (
          <li>
            <img class="paso-img" src={p.img} alt={p.alt} loading="lazy" width="600" height="750" />
            <span class="n">{i + 1}</span>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- RECOMENDADOR: cómo funciona (carrusel de 4 diapositivas) -->
  <section class="section rec" id="recomendador">
    <div class="container">
      <p class="eyebrow center">Recomendador Robin</p>
      <h2 class="display-md center section-title">Así funciona el recomendador</h2>
      <div class="rec-carousel" data-rec aria-roledescription="carrusel" aria-label="Cómo funciona el recomendador">
        <ol class="rec-track" data-rec-track>
          <li class="rec-slide rec-slide--intro" aria-roledescription="diapositiva" aria-label="1 de 4">
            <div class="rec-intro-text">
              <p class="rec-kicker">Qué es</p>
              <h3 class="rec-title">Menos dudas. Más claridad para cada alumno.</h3>
              <p>Orientar a decenas de estudiantes requiere tiempo y una atención muy personalizada. El recomendador de Robin analiza el perfil académico, los intereses y las aspiraciones de cada alumno para identificar los grados universitarios que mejor encajan con él.</p>
              <p>En pocos minutos, el orientador obtiene recomendaciones reales y explicadas que le permiten iniciar conversaciones más útiles, detectar nuevas posibilidades y acompañar cada decisión con mayor criterio.</p>
            </div>
            <img class="rec-plane" src="/fotos/recomendador-avion.webp" alt="" width="470" height="260" loading="lazy" />
          </li>
          <li class="rec-slide" aria-roledescription="diapositiva" aria-label="2 de 4">
            <p class="rec-kicker">Cómo lo usa el alumno</p>
            <h3 class="rec-title">Cuatro pasos, unos minutos</h3>
            <ol class="rec-steps">
              {
                recPasos.map((p, i) => (
                  <li>
                    <span class:list={['rec-n', { 'is-last': i === recPasos.length - 1 }]}>{i + 1}</span>
                    <strong>{p.t}</strong>
                    <span>{p.d}</span>
                  </li>
                ))
              }
            </ol>
            <p class="rec-note">Las preguntas se adaptan al área que elige cada alumno.</p>
          </li>
          <li class="rec-slide" aria-roledescription="diapositiva" aria-label="3 de 4">
            <p class="rec-kicker">Qué tiene en cuenta</p>
            <h3 class="rec-title">Todo el perfil del alumno, no solo sus notas</h3>
            <ul class="rec-cards">
              {
                recSenales.map((s) => (
                  <li>
                    <strong>{s.t}</strong>
                    <span>{s.d}</span>
                  </li>
                ))
              }
            </ul>
            <p class="rec-note">Lo que escribe con sus palabras suma cuando aporta algo concreto, pero nunca sustituye al resto del perfil.</p>
          </li>
          <li class="rec-slide" aria-roledescription="diapositiva" aria-label="4 de 4">
            <p class="rec-kicker">Qué obtenéis</p>
            <h3 class="rec-title">Recomendaciones claras y explicadas</h3>
            <p>Para cada grado recomendado, el alumno y el orientador ven:</p>
            <ol class="rec-list">{recResultado.map((r) => <li>{r}</li>)}</ol>
            <p class="rec-note">Solo recomienda grados que existen de verdad. Es una orientación, no una decisión de admisión: los requisitos dependen de cada grado.</p>
          </li>
        </ol>
        <div class="rec-nav">
          <button type="button" class="rec-arrow" data-rec-prev aria-label="Diapositiva anterior">←</button>
          <div class="rec-dots" role="tablist">
            {[1, 2, 3, 4].map((n) => <button type="button" class="rec-dot" data-rec-dot={n - 1} aria-label={`Ir a la diapositiva ${n}`} />)}
          </div>
          <button type="button" class="rec-arrow" data-rec-next aria-label="Diapositiva siguiente">→</button>
        </div>
      </div>
      <p class="center rec-cta">
        <a class="btn" href={RECOMENDADOR.colegiosUrl} target="_blank" rel="noopener">Solicitar acceso</a>
      </p>
    </div>
  </section>

  <section class="section-sm bg-cream">
    <div class="container center">
      <p class="eyebrow">Colegios Robin</p>
      <h2 class="display-md section-title">Centros que ya confían en nosotros</h2>
      <p class="text">Colegios e institutos en España y LATAM que colaboran con Robin para orientar a sus alumnos hacia universidades europeas.</p>
      <ul class="cols">
        {colegios.map((c) => <li>{c}</li>)}
        <li class="next">+ Tu cole pronto</li>
      </ul>
    </div>
  </section>

  <section class="bg-navy talk" id="formulario-colegios">
    <div class="container talk-grid">
      <div>
        <p class="eyebrow text-accent">Para el colegio</p>
        <h2 class="display-md">¿Hablamos?</h2>
        <p class="text">Diseñamos el plan específico para vuestro centro. Primera reunión sin coste — presencial en Madrid o online.</p>
        <p class="lbl">Email colegios</p>
        <p><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></p>
        <p class="lbl">Teléfono directo</p>
        <p><a href={`tel:${CONTACT.phone.replace(/\s/g, '')}`}>{CONTACT.phone}</a></p>
      </div>
      <div class="form-card">
        <h3>Formulario colegios</h3>
        <p class="small">Respondemos en menos de 24h laborables.</p>
        <LeadForm form="colegios" tag="colegios" submitLabel="Enviar solicitud" />
      </div>
    </div>
  </section>
</Base>

<script>
  // Carrusel del recomendador: se desliza con el dedo/trackpad, con las flechas o con los puntos
  document.querySelectorAll('[data-rec]').forEach((root) => {
    const track = root.querySelector('[data-rec-track]');
    const slides = [...track.children];
    const dots = [...root.querySelectorAll('[data-rec-dot]')];
    const prev = root.querySelector('[data-rec-prev]');
    const next = root.querySelector('[data-rec-next]');
    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (i) => track.scrollTo({ left: Math.max(0, Math.min(slides.length - 1, i)) * track.clientWidth, behavior: 'smooth' });
    let idx = 0;
    const update = () => {
      const i = (idx = current());
      dots.forEach((d, n) => d.setAttribute('aria-current', n === i ? 'true' : 'false'));
      prev.disabled = i === 0;
      next.disabled = i === slides.length - 1;
      slides.forEach((s, n) => s.setAttribute('aria-hidden', n === i ? 'false' : 'true'));
    };
    prev.addEventListener('click', () => go(current() - 1));
    next.addEventListener('click', () => go(current() + 1));
    dots.forEach((d, n) => d.addEventListener('click', () => go(n)));
    track.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    // Si cambia el ancho (girar el móvil, redimensionar), se queda en la misma diapositiva
    new ResizeObserver(() => track.scrollTo({ left: idx * track.clientWidth })).observe(track);
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') go(current() + 1);
      if (e.key === 'ArrowLeft') go(current() - 1);
    });
    update();
  });
</script>

