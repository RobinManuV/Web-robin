---
import '../../styles/pages/producto.css';
// Ficha de producto de la tienda Robin (/tienda/<slug>/).
// El pedido se envía como solicitud (formulario → Notion, etiqueta "tienda-<slug>")
// con la talla y la cantidad en el mensaje; Robin contacta para el pago y el envío.
import Base from '../../layouts/Base.astro';
import LeadForm from '../../components/LeadForm.astro';
import { PRODUCTOS, TALLAS, GUIA_TALLAS, GUIA_MEDIDAS } from '../../data/tienda.js';

export function getStaticPaths() {
  return PRODUCTOS.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const otros = PRODUCTOS.filter((x) => x.slug !== p.slug);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  description: p.short,
  brand: { '@type': 'Brand', name: 'Robin' },
  ...(p.img ? { image: `https://project-robin.com${p.img}` } : {}),
  offers: {
    '@type': 'Offer',
    price: p.priceNum,
    priceCurrency: 'EUR',
    availability: p.comingSoon ? 'https://schema.org/PreOrder' : 'https://schema.org/InStock',
    url: `https://project-robin.com/tienda/${p.slug}/`,
  },
};
---

<Base pageClass="page-producto" title={`${p.name}${p.comingSoon ? ' (coming soon)' : ''} | Tienda Robin`} description={p.short} image={p.img || undefined} schema={schema}>
  <section class="container prod">
    <a class="link-back" href="/comunidad/#tienda">« Volver a la tienda</a>
    <div class="prod-grid">
      <div class="gallery" data-gallery>
        {
          p.gallery.length > 0 ? (
            <>
              <div class="main">
                <img src={p.gallery[0].src} alt={p.gallery[0].alt} data-main width="900" height="900" />
                {p.comingSoon && <span class="soon-badge">Coming soon</span>}
              </div>
              {p.gallery.length > 1 && (
                <div class="thumbs">
                  {p.gallery.map((g, i) => (
                    <button type="button" class:list={{ on: i === 0 }} data-thumb={g.src} data-alt={g.alt} aria-label={`Ver foto ${i + 1}`}>
                      <img src={g.src} alt="" loading="lazy" width="120" height="120" />
                    </button>
                  ))}
                </div>
              )}
            </>
          ) : (
            <div class="main soon-art">
              <p>Coming soon</p>
            </div>
          )
        }
      </div>

      <div class="info">
        <p class="eyebrow">Tienda Robin</p>
        <h1 class="display-md">{p.name}</h1>
        <p class="price">{p.price}</p>
        {p.description.map((d) => <p class="text">{d}</p>)}

        {
          p.comingSoon ? (
            <div class="soon-box">
              <p class="soon-title">Coming soon</p>
              <p>Estamos terminando los últimos detalles. ¿Quieres que te avisemos cuando esté disponible?</p>
              <a class="btn" href={`/contacto/?origen=tienda-${p.slug}&servicio=Otro`}>
                Avísame
              </a>
            </div>
          ) : (
            <div class="order">
              {p.tallas && (
                <div class="opts">
                  <span class="opt-label">Talla</span>
                  <div class="tallas" role="radiogroup" aria-label="Talla">
                    {TALLAS.map((t, i) => (
                      <label class="talla">
                        <input type="radio" name="talla-sel" value={t} checked={t === 'M'} data-talla />
                        <span>{t}</span>
                      </label>
                    ))}
                  </div>
                  <a class="guia-link" href="#guia-tallas">
                    Guía de tallas
                  </a>
                </div>
              )}
              <div class="opts">
                <label for="cantidad">Cantidad</label>
                <input id="cantidad" type="number" min="1" max="20" value="1" data-cantidad />
              </div>
              <a class="btn btn-lg" href="#pedido">
                Lo quiero · {p.price}
              </a>
              <p class="small note">Déjanos tus datos y te escribimos para cerrar el pago y el envío.</p>
            </div>
          )
        }
      </div>
    </div>
  </section>

  {
    p.tallas && (
      <section class="section-sm bg-cream" id="guia-tallas">
        <div class="container guia">
          <div>
            <p class="eyebrow">Guía de tallas</p>
            <h2 class="display-md">Encuentra tu talla</h2>
            <p class="text">Mide una camiseta que te quede bien, estirada sobre una superficie plana, y compárala con la tabla: A es el largo total, B el ancho de hombros, C el ancho de pecho y D el largo de manga. Si dudas entre dos tallas, elige la mayor.</p>
          </div>
          <div class="guia-right">
            <img class="guia-img" src="/fotos/guia-tallas-camiseta.webp" alt="Esquema de medidas: A largo total, B ancho de hombros, C ancho de pecho, D largo de manga" loading="lazy" width="540" height="440" />
            <table class="tallas-table">
              <caption class="small">Medidas en centímetros, prenda en plano.</caption>
              <thead>
                <tr>
                  <th scope="col">cm</th>
                  {GUIA_TALLAS.map((g) => (
                    <th scope="col">{g.talla}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {GUIA_MEDIDAS.map((m) => (
                  <tr>
                    <th scope="row">
                      <strong>{m.key}</strong> <span class="medida">{m.label}</span>
                    </th>
                    {GUIA_TALLAS.map((g) => (
                      <td>{g[m.key]}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>
    )
  }

  {
    !p.comingSoon && (
      <section class="section-sm container" id="pedido">
        <div class="pedido-card">
          <h2 class="display-md">Pide tu {p.name.toLowerCase()}</h2>
          <p class="text">Te escribimos en menos de 24 horas para confirmar el pago y el envío.</p>
          <LeadForm form="contacto" tag={`tienda-${p.slug}`} servicio="Otro" submitLabel="Enviar pedido" />
        </div>
      </section>
    )
  }

  <section class="section-sm container otros">
    <p class="eyebrow center">También en la tienda</p>
    <div class="otros-grid">
      {
        otros.map((o) => (
          <a class="otro" href={`/tienda/${o.slug}/`}>
            {o.img ? <img src={o.img} alt={o.name} loading="lazy" width="400" height="400" /> : <span class="otro-soon">Coming soon</span>}
            <span class="otro-name">{o.name}</span>
            <span class="otro-price">
              {o.price}
              {o.comingSoon && ' · Coming soon'}
            </span>
          </a>
        ))
      }
    </div>
  </section>
</Base>

<script>
  // Galería: cambiar la foto principal
  document.querySelectorAll('[data-gallery]').forEach((g) => {
    const main = g.querySelector('[data-main]');
    g.querySelectorAll('[data-thumb]').forEach((b) =>
      b.addEventListener('click', () => {
        main.src = b.dataset.thumb;
        main.alt = b.dataset.alt;
        g.querySelectorAll('[data-thumb]').forEach((x) => x.classList.toggle('on', x === b));
      }),
    );
  });
  // Pedido: la talla y la cantidad se escriben en el mensaje del formulario
  const form = document.querySelector('#pedido form');
  if (form) {
    const msg = form.querySelector('textarea[name="mensaje"]');
    const name = document.querySelector('h1')?.textContent?.trim();
    const sync = () => {
      const talla = document.querySelector('[data-talla]:checked')?.value;
      const cant = document.querySelector('[data-cantidad]')?.value || '1';
      msg.value = `Pedido: ${name}${talla ? ` · Talla ${talla}` : ''} · ${cant} ud.`;
    };
    document.querySelectorAll('[data-talla], [data-cantidad]').forEach((el) => el.addEventListener('change', sync));
    sync();
  }
</script>

