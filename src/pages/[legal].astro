---
import '../styles/pages/legal.css';
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const pages = await getCollection('legal');
  return pages.map((p) => ({ params: { legal: p.id }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await render(p);
---

<Base pageClass="page-legal" title={`${p.data.title} | Project Robin`} description={p.data.description}>
  <article class="legal">
    <p class="eyebrow center">Legal</p>
    <h1 class="title center">{p.data.title}</h1>
    {
      p.id === 'politica-de-cookies' && (
        <p class="center cookie-prefs">
          <button type="button" class="btn" data-open-cookies>
            Cambiar mis preferencias de cookies
          </button>
        </p>
      )
    }
    <div class="prose"><Content /></div>
  </article>
</Base>

