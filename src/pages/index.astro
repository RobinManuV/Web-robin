---
import Base from '../layouts/Base.astro';
import YouTube from '../components/YouTube.astro';
import Testimonials from '../components/Testimonials.astro';
import DescubreHolanda from '../components/DescubreHolanda.astro';
import ContactSection from '../components/ContactSection.astro';
import Icon from '../components/Icon.astro';
import { EQUIPO, CIFRAS } from '../data/site.js';

const paquetes = [
  {
    title: 'España',
    popular: true,
    img: '/wp-content/uploads/2026/05/46c3c403c37f85f32d0b79f4d054d084.webp',
    stamped: true,
    bullets: ['Opciones académicas en distintas ciudades.', 'Programas adaptados a tu perfil.', 'Orientación para elegir el mejor destino.'],
    text: 'Explora alternativas de estudio en España con una propuesta clara para ayudarte a valorar ciudades, campus y oportunidades disponibles.',
    cta: 'Estudia en España',
    href: '/estudiar-universidad-espana/',
  },
  {
    title: 'Multicampus',
    img: '/wp-content/uploads/2026/05/d79ba2af1559ff1148830b83eea1fead.webp',
    stamped: true,
    bullets: ['Compara campus y destinos disponibles.', 'Más flexibilidad para tu plan de estudios.', 'Encuentra la opción que mejor se adapte a ti.'],
    text: 'Una opción pensada para quienes buscan flexibilidad y quieren valorar diferentes campus antes de tomar una decisión final.',
    cta: 'Estudia en Multicampus',
    href: '/the-european-experience/',
  },
  {
    title: 'Holanda',
    img: '/wp-content/uploads/2026/05/amsterdam-cityscape-view-2026-03-20-01-59-27-utc-1024x683.jpg',
    stamped: false,
    bullets: ['Universidades y programas en Holanda.', 'Información sobre requisitos y admisión.', 'Acompañamiento durante el proceso.'],
    text: 'Descubre opciones de estudio en Holanda y encuentra el destino que mejor encaja con tu perfil, tus objetivos y tu forma de estudiar.',
    cta: 'Estudia en Holanda',
    href: '/destinos/',
  },
];

const pasos = [
  {
    tab: 'Elige',
    img: '/wp-content/uploads/2026/06/RobinTelescopio.webp',
    title: 'Elegimos contigo, no por ti',
    text: 'Analizamos tu perfil, tus notas y tu presupuesto, y te damos una lista corta de universidades que encajan contigo. Requisitos, costes y salidas encima de la mesa desde el primer día.',
    bullets: ['Análisis de tu perfil y presupuesto', 'Shortlist de universidades compatibles', 'Costes y salidas, sin letra pequeña'],
  },
  {
    tab: 'Aplica',
    img: '/wp-content/uploads/2026/06/Robin-Carpetas.webp',
    title: 'Tu aplicación, sin sustos',
    text: 'Carta de motivación, documentos, plazos y plataformas como Studielink. Preparamos tu perfil contigo y lo revisamos todo antes de enviarlo para que no se escape nada.',
    bullets: ['Carta de motivación y CV revisados', 'Calendario de plazos a tu medida', 'Aplicación gestionada paso a paso'],
  },
  {
    tab: 'Aterriza',
    img: '/wp-content/uploads/2026/06/RobinHouse.webp',
    badge: 'Housing garantizado',
    title: 'Tu casa, asegurada',
    text: 'Encontrar piso siendo estudiante internacional es un deporte extremo. Lo sabemos porque lo vivimos. Por eso te garantizamos el alojamiento y te ayudamos con la mudanza para que llegues con todo organizado.',
    bullets: ['Alojamiento garantizado', 'Ayuda para preparar la mudanza', 'Todo listo desde el primer día'],
  },
  {
    tab: 'Despega',
    img: '/wp-content/uploads/2026/06/RobinGraduated.webp',
    title: 'Seguimos contigo cuando llegas',
    text: 'No desaparecemos cuando te admiten. Te acompañamos en los últimos pasos, resolvemos tus dudas y te asesoramos con las ayudas al estudiante para que empieces tu nueva etapa con confianza.',
    bullets: ['Dudas resueltas cuando surjan', 'Asesoramiento en ayudas económicas', 'Acceso a la comunidad Robin'],
  },
];

const incluye = [
  { icon: 'compass', title: 'Selección de carreras', text: 'Sabrás qué estudiar y dónde, con datos: requisitos, costes y salidas de cada opción.' },
  { icon: 'doc', title: 'Proceso de aplicación', text: 'Cartas de motivación, documentos legales y plazos. Todo revisado antes de enviarlo.' },
  { icon: 'home', title: 'Housing garantizado', text: 'Tienes casa asegurada. Hemos vivido allí y sabemos dónde y cómo buscar.', highlight: true },
  { icon: 'coin', title: 'Ayudas económicas', text: 'Te explicamos las ayudas al estudiante del gobierno holandés y cómo solicitarlas.' },
];

const equipoFotos = [
  '/wp-content/uploads/2026/05/d7ed3b562ab2781c4c0674a1da19ee84.webp',
  '/wp-content/uploads/2026/05/438c8c8e556189a826ba8ff9eba1dafa.webp',
  '/wp-content/uploads/2026/05/0f4f5067744817baf312cc3460fdbe03.webp',
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Project Robin',
  url: 'https://project-robin.com/',
  inLanguage: 'es-ES',
  publisher: { '@id': 'https://project-robin.com/#organization' },
};
---

<Base title="Estudiar en Holanda con acompañamiento | Project Robin" schema={schema}>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-inner container">
      <div class="hero-text">
        <p class="eyebrow text-cream">The world is your campus</p>
        <h1 class="display-xl hero-title">Más cerca de tu sueño, estudia en el extranjero</h1>
        <p class="lead hero-lead">
          Hablamos sin rodeos, costes, becas, riesgos y beneficios.<br />
          Te guiamos desde ¿y si me voy? hasta tu primera clase en Europa
        </p>
        <div class="btn-row">
          <a class="btn" href="#reserva">Reserva tu consulta online</a>
          <a class="btn btn-outline-light" href="#como-funciona">Cómo funciona</a>
        </div>
      </div>
      <div class="hero-map" role="img" aria-label="Mapa con las rutas de estudiantes de Robin entre América y Europa"></div>
    </div>
  </section>

  <!-- CÓMO FUNCIONA -->
  <section class="bg-cream section" id="como-funciona">
    <div class="container voices">
      <div class="stack" style="--stack:34px">
        <p class="eyebrow">Cómo funciona</p>
        <h2 class="display-md">Voces de nuestros Robins: de estudiante a estudiante</h2>
        <p class="lead">Conoce la verdad de quiénes ya volaron a Holanda y hoy te ayudan a que tu propio viaje sea claro, posible y transformador.</p>
        <a class="btn" href="/sobre-nosotros/">Nosotros</a>
      </div>
      <YouTube url="https://youtu.be/psjEcd2yAeg" poster="/wp-content/uploads/2026/05/a6f1b0f7b8b6e609fb8387ac02dc8ff3.webp" title="Voces de nuestros Robins" />
    </div>
  </section>

  <!-- PAQUETES -->
  <section class="bg-cream section packs-section">
    <div class="container">
      <div class="center stack" style="--stack:18px">
        <p class="eyebrow">Nuestros paquetes</p>
        <h2 class="display">Elige tu aventura</h2>
        <p class="lead packs-lead">Tres caminos, un equipo detrás. Te acompañamos donde tiene sentido ir: Holanda, España o un grado europeo multicampus.</p>
      </div>
      <div class="packs">
        <img class="packs-bird" src="/wp-content/uploads/2026/05/a711e425cce1f3a3c8c74cb6f495f1f4.webp" alt="" width="257" height="256" loading="lazy" />
        {
          paquetes.map((p) => (
            <article class="pack">
              {p.popular && <p class="pack-badge">Más popular</p>}
              <div class="pack-img">
                <img class:list={{ stamp: !p.stamped }} src={p.img} alt={`Estudiar en ${p.title}`} width="401" height="296" loading="lazy" />
                <h3>{p.title}</h3>
              </div>
              <ul class="tick-list pack-list">
                {p.bullets.map((b) => <li>{b}</li>)}
              </ul>
              <p class="pack-text">{p.text}</p>
              <a class="btn btn-sm" href={p.href}>{p.cta}</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- MÉTODO ROBIN -->
  <section class="section">
    <div class="container center stack" style="--stack:20px">
      <p class="eyebrow">Método Robin</p>
      <h2 class="display">Te guiamos de principio a fin</h2>
      <p class="lead">Sin falsas promesas. Un proceso claro, transparente y probado. Paso a paso</p>
    </div>
    <div class="container">
      <div class="method" data-method>
        <div class="method-tabs" role="tablist" aria-label="Fases del Método Robin">
          <span class="method-progress" aria-hidden="true"><span data-progress></span></span>
          {
            pasos.map((p, i) => (
              <button type="button" role="tab" class="method-tab" id={`fase-tab-${i}`} aria-controls={`fase-${i}`} aria-selected={i === 0 ? 'true' : 'false'} data-tab={i}>
                <span class="method-dot">{i + 1}</span>
                <span class="method-tab-label">{p.tab}</span>
              </button>
            ))
          }
        </div>
        <div class="method-viewport">
          <ol class="method-track" data-track>
            {
              pasos.map((p, i) => (
                <li class="method-slide" id={`fase-${i}`} role="tabpanel" aria-labelledby={`fase-tab-${i}`} aria-roledescription="fase">
                  <div class="method-art">
                    <img src={p.img} alt="" loading="lazy" width="220" height="220" />
                  </div>
                  <div class="method-copy">
                    <p class="method-kicker">
                      Fase {i + 1} de {pasos.length}
                      {p.badge && <span class="method-badge">{p.badge}</span>}
                    </p>
                    <h3>{p.title}</h3>
                    <p class="method-text">{p.text}</p>
                    <ul class="tick-list">
                      {p.bullets.map((b) => <li>{b}</li>)}
                    </ul>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="method-nav">
          <button type="button" class="method-arrow" data-prev aria-label="Fase anterior">←</button>
          <button type="button" class="method-arrow" data-next aria-label="Fase siguiente">→</button>
        </div>
      </div>
      <div class="btn-row" style="justify-content:center">
        <a class="btn" href="/servicios/asesoramiento-completo/">Pack Llegada</a>
        <a class="btn btn-outline" href="/servicios/mentoria/">Mentoría 90 minutos</a>
      </div>
    </div>
  </section>

  <!-- TESTIMONIOS -->
  <section class="testi rounded-block">
    <div class="container testi-grid">
      <div class="stack" style="--stack:24px">
        <p class="eyebrow text-cream">Lo que dicen nuestros Robins</p>
        <h2 class="display-md text-cream">Historias reales, sin filtros.</h2>
        <p class="text text-cream">Conoce la verdad de quiénes ya volaron a Holanda y hoy te ayudan a que tu propio viaje sea claro, posible y transformador.</p>
        <a class="btn" href="/comunidad/">Ver todos los testimonios</a>
      </div>
      <Testimonials />
    </div>
  </section>

  <!-- QUÉ INCLUYE -->
  <section class="section">
    <div class="container incluye">
      <div class="incluye-head stack" style="--stack:20px">
        <p class="eyebrow">Qué incluye</p>
        <h2 class="display-md">Todo lo que necesitas, un solo equipo</h2>
        <p class="lead">Nada de ir saltando entre agencias, foros y grupos de WhatsApp. Lo tienes todo en un sitio, con gente que ya lo ha vivido.</p>
        <a class="btn" href="#reserva">Reserva tu consulta</a>
      </div>
      <ul class="incluye-grid">
        {
          incluye.map((s, i) => (
            <li class:list={['inc', { highlight: s.highlight }]} style={`--d:${i * 90}ms`} data-reveal>
              <span class="inc-icon">
                <Icon name={s.icon} size={30} />
              </span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- CIFRAS -->
  <section class="stats">
    <div class="stats-img">
      <img src="/wp-content/uploads/2026/05/shot-of-two-young-women-studying-together-at-colle-2026-01-09-10-58-49-utc.jpg" alt="Estudiantes internacionales estudiando juntas en Holanda" loading="lazy" />
    </div>
    <div class="stats-box">
      <p class="eyebrow">Experiencia</p>
      <h2 class="display-md">Los números nos avalan</h2>
      <p class="lead">No solo se trata de estadísticas, se trata de historias de éxito, sueños cumplidos y metas alcanzadas.</p>
      <dl class="counters">
        {
          CIFRAS.map((c) => (
            <div>
              <dt class="sr-only">{c.label}</dt>
              <dd>
                <span class="num" data-count={c.value}>{c.value}</span>
                {c.suffix}
              </dd>
              <dd class="lbl" aria-hidden="true">
                {c.label}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- EQUIPO -->
  <section class="section">
    <div class="container-narrow center stack" style="--stack:24px">
      <p class="eyebrow">El equipo Robin</p>
      <h2 class="display-md">Estuvimos en tu silla, por eso estamos en la nuestra</h2>
      <p class="lead">
        Hace unos años tomamos una de las decisiones más importantes e ilusionantes de nuestras vidas: ir a estudiar al extranjero. Por aquel entonces, sentimos la falta de una guía clara y cercana. Impulsados por esa experiencia, decidimos crear lo que nos faltó en su momento: Robin.
      </p>
      <a class="btn" href="/sobre-nosotros/">Conoce al equipo</a>
    </div>
    <div class="team container">
      {
        EQUIPO.map((m, i) => (
          <article class="member" style={`background-image:url('${equipoFotos[i]}')`}>
            <div class="member-info">
              <h3>{m.name}</h3>
              <p>{m.bio}</p>
              <a href={m.linkedin} target="_blank" rel="noopener">
                LinkedIn
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- DESCUBRE HOLANDA -->
  <div class="container">
    <DescubreHolanda />
  </div>

  <ContactSection tag="general" />
</Base>

<script>
  // Animación de los contadores (el número real ya está escrito en el HTML)
  const nums = document.querySelectorAll('[data-count]');
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const el = e.target;
        const to = Number(el.dataset.count);
        const t0 = performance.now();
        const tick = (t) => {
          const p = Math.min(1, (t - t0) / 1400);
          el.textContent = String(Math.round(to * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
        io.unobserve(el);
      });
    },
    { threshold: 0.6 },
  );
  nums.forEach((n) => io.observe(n));

  // Aparición suave de las tarjetas de "Qué incluye"
  const rev = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        e.target.classList.add('is-in');
        rev.unobserve(e.target);
      });
    },
    { threshold: 0.2 },
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => rev.observe(el));

  // Carrusel del Método Robin: pestañas, flechas, swipe (scroll-snap) y avance automático
  document.querySelectorAll('[data-method]').forEach((root) => {
    const track = root.querySelector('[data-track]');
    const slides = [...track.children];
    const tabs = [...root.querySelectorAll('[data-tab]')];
    const bar = root.querySelector('[data-progress]');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0;
    let timer;
    let userTook = false;

    const paint = (n) => {
      i = n;
      tabs.forEach((t, k) => {
        t.setAttribute('aria-selected', String(k === n));
        t.classList.toggle('done', k < n);
        t.tabIndex = k === n ? 0 : -1;
      });
      bar.style.width = `${(n / (slides.length - 1)) * 100}%`;
    };
    const go = (n) => {
      n = (n + slides.length) % slides.length;
      track.scrollTo({ left: slides[n].offsetLeft - track.offsetLeft, behavior: reduce ? 'auto' : 'smooth' });
      paint(n);
    };
    const stop = () => {
      userTook = true;
      clearInterval(timer);
    };
    const start = () => {
      if (reduce || userTook) return;
      clearInterval(timer);
      timer = setInterval(() => go(i + 1), 6000);
    };

    tabs.forEach((t, k) => t.addEventListener('click', () => (stop(), go(k))));
    root.querySelector('[data-prev]').addEventListener('click', () => (stop(), go(i - 1)));
    root.querySelector('[data-next]').addEventListener('click', () => (stop(), go(i + 1)));
    root.querySelector('[role=tablist]').addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      stop();
      go(i + (e.key === 'ArrowRight' ? 1 : -1));
      tabs[i].focus();
    });
    track.addEventListener('pointerdown', stop, { passive: true });
    track.addEventListener('touchstart', stop, { passive: true });
    root.addEventListener('mouseenter', () => clearInterval(timer));
    root.addEventListener('mouseleave', start);

    // Si el usuario desliza con el dedo o el trackpad, sincronizamos las pestañas
    const seen = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) paint(slides.indexOf(e.target));
        });
      },
      { root: track, threshold: 0.6 },
    );
    slides.forEach((s) => seen.observe(s));

    // Solo arranca el avance automático cuando la sección está a la vista
    new IntersectionObserver(([e]) => (e.isIntersecting ? start() : clearInterval(timer)), { threshold: 0.4 }).observe(root);
    paint(0);
  });
</script>

<style>
  /* HERO */
  .hero {
    background: var(--navy);
    border-radius: 0 0 24px 24px;
    overflow: hidden;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(30px, 4vw, 70px);
    min-height: 715px;
    padding-block: 80px;
  }
  /* El GIF es 1600x900 con el mapa en x 628-1572 / y 80-820: recortamos solo el mapa
     para que quede dentro del contenedor, alineado con el texto. */
  .hero-map {
    width: 100%;
    aspect-ratio: 945 / 740;
    background: url('/wp-content/uploads/2026/07/hero-global-wide-spain-corrected-animated.gif') 95.9% 50% / 169.3% auto no-repeat;
  }
  .hero-title {
    color: var(--cream-text);
    font-size: clamp(44px, 5.2vw, 84px);
    margin: 14px 0 22px;
  }
  .hero-lead {
    color: var(--cream-text);
    max-width: 640px;
    font-size: clamp(18px, 1.5vw, 21px);
    margin-bottom: 26px;
  }
  .hero .btn {
    font-size: 16px;
    padding: 10px 20px;
  }

  /* VOCES */
  .voices {
    display: grid;
    grid-template-columns: 1fr 1.9fr;
    gap: 70px;
    align-items: center;
  }
  .voices .display-md {
    font-size: clamp(34px, 3.9vw, 56px);
  }

  /* PAQUETES */
  .packs-section {
    padding-top: 0;
  }
  .packs-lead {
    max-width: 700px;
    margin-inline: auto;
  }
  .packs {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 372px));
    justify-content: center;
    gap: 80px;
    margin-top: 150px;
  }
  .packs-bird {
    position: absolute;
    right: calc(50% - 600px);
    top: -130px;
    width: 180px;
  }
  .pack {
    position: relative;
    background: var(--grey);
    border: 2px solid var(--navy);
    border-radius: 16px;
    padding: 96px 32px 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .pack-badge {
    position: absolute;
    top: -58px;
    left: 34px;
    right: 34px;
    background: var(--navy);
    color: var(--cream);
    border-radius: 12px 12px 0 0;
    text-align: center;
    padding: 16px 10px 20px;
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .pack-img {
    position: relative;
  }
  .pack-img img {
    width: 100%;
    aspect-ratio: 401 / 296;
    object-fit: cover;
  }
  .pack-img h3 {
    position: absolute;
    top: 12px;
    left: 0;
    right: 0;
    text-align: center;
    color: var(--cream-text);
    font-size: clamp(30px, 3vw, 42px);
    font-weight: 800;
    text-transform: uppercase;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.25);
  }
  .pack-list {
    font-size: 17px;
  }
  .pack-text {
    font-size: 17px;
    flex: 1;
  }
  .pack .btn {
    align-self: center;
  }

  /* MÉTODO (carrusel) */
  .method {
    max-width: 1140px;
    margin: 56px auto 40px;
  }
  .method-tabs {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-bottom: 28px;
  }
  .method-progress {
    position: absolute;
    left: 12.5%;
    right: 12.5%;
    top: 27px;
    height: 3px;
    background: var(--grey-card);
    border-radius: 3px;
  }
  .method-progress span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--accent);
    border-radius: inherit;
    transition: width 0.5s ease;
  }
  .method-tab {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 10px;
    background: none;
    border: 0;
    padding: 0 6px;
    color: var(--navy);
  }
  .method-dot {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 22px;
    font-weight: 700;
    background: var(--white);
    border: 3px solid var(--grey-card);
    transition: background 0.3s, border-color 0.3s, color 0.3s, transform 0.3s;
  }
  .method-tab-label {
    font-size: 17px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    opacity: 0.55;
    transition: opacity 0.3s;
  }
  .method-tab.done .method-dot {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--white);
