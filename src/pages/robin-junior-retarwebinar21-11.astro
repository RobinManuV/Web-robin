---
import '../styles/pages/landing-junior.css';
// Landing de campaña de ROBIN JUNIOR (programa para alumnos de 1º de Bachillerato).
// URL: /robin-junior-retarwebinar21-11/ — retargeting para las FAMILIAS del webinar de padres del 21 de noviembre.
// NO se enlaza desde ninguna parte de la web, no sale en el sitemap, está en robots.txt y lleva noindex.
// Solo existe en español (ver SOLO_ES en src/i18n/config.mjs).
//
// Público: los padres (se les habla de tú / vosotros y del alumno como «tu hijo o hija»).
// Como piden números claros, hay un bloque «Lo que incluye y lo que no» sin letra pequeña.
// Objetivo ÚNICO: que reserven la llamada informativa gratuita (reservador con la etiqueta "robin-junior-retarwebinar21-11").
// Base con `minimal`: solo logo; el menú de Robin aparece únicamente al pulsar el logo.
//
// Contenido sacado del PDF «Robin Junior» (8 sesiones online de octubre a junio, 1.499 €, −10% si sigue en 2º).
// Incluido: las 8 sesiones (la de inglés es solo la sesión de evaluación de nivel).
// Aparte: summer school, apoyo para la PAU y clases de inglés posteriores.
// Si cambia el programa o el precio, se cambia en las constantes de abajo.
import Base from '../layouts/Base.astro';
import BookingWidget from '../components/BookingWidget.astro';
import { CONTACT } from '../data/site.js';

const TAG = 'robin-junior-retarwebinar21-11';
const PRECIO = '1.499 €';
const DESCUENTO = '−10%';

// Todos los alumnos son de 1º, así que va marcado por defecto en el reservador
const CURSOS = ['1º de Bachillerato', 'Otro curso'];

const marquee = [
  '8 sesiones online',
  'De octubre a junio',
  'Test de compatibilidad con IA',
  'Mentorías con exalumnos',
  'Summer school en Países Bajos',
  'Jornadas de puertas abiertas',
  'Diagnóstico de inglés',
];

const sesiones = [
  {
    n: '1',
    kicker: 'Octubre · Sesión 1',
    title: 'Diagnóstico',
    text: 'Conocemos su perfil y le explicamos cómo funciona Países Bajos.',
    chip: '🧠 Test de compatibilidad con IA',
  },
  {
    n: '2',
    kicker: 'Sesión 2',
    title: 'Sus resultados',
    text: 'Las carreras y universidades más compatibles con él o ella. Elige sus 3 favoritas.',
  },
  {
    n: '3-5',
    kicker: '3 sesiones',
    title: 'Mentorías con exalumnos',
    text: 'Una por cada carrera favorita: se lo cuenta alguien que ya la ha vivido.',
    destacado: true,
  },
  {
    n: '6-7',
    kicker: '2 sesiones',
    title: 'Sesiones grupales',
    text: 'Con mentores profesionales, junto a otros estudiantes.',
  },
  {
    n: '8',
    kicker: 'Inglés · sesión de evaluación',
    title: 'Diagnóstico con nuestra profe',
    text: 'Evaluamos su nivel de inglés: el primer paso hacia el C1 que le abrirá las puertas.',
  },
];

const extras = [
  {
    emoji: '☀️',
    title: 'Summer school en Países Bajos',
    text: 'Entre 1º y 2º, en la universidad de sus sueños. Suma puntos en su solicitud.',
    badge: 'Os lo gestionamos',
    aparte: true,
  },
  {
    emoji: '🏛️',
    title: 'Jornadas de puertas abiertas',
    text: 'Visita la universidad y la carrera antes de decidir.',
    badge: 'Os lo organizamos',
  },
  {
    emoji: '📚',
    title: 'Apoyo para la PAU',
    text: 'Preparación en 1º y 2º de Bachillerato.',
    badge: 'Opcional',
    opcional: true,
    aparte: true,
  },
];

const cuentas = [
  { k: 'Precio', v: `${PRECIO}, programa completo de 1º de Bachillerato.` },
  { k: 'Incluye', v: '8 sesiones online de octubre a junio. La de inglés es la sesión de evaluación de nivel.' },
  { k: 'Se paga aparte', v: 'La summer school, el apoyo para la PAU (opcional) y las clases de inglés, si después las quiere.' },
  { k: 'Si sigue en 2º', v: `${DESCUENTO} en el programa de 2º de Bachillerato.` },
];

const faqs = [
  {
    q: '¿No es pronto para pensar en la universidad en 1º?',
    a: 'Es justo el momento. En 2º se juntan la PAU, las notas que cuentan y los plazos de aplicación. Si llega con sus carreras elegidas y su solicitud reforzada, 2º es solo ejecutar.',
  },
  {
    q: 'Todavía no sabe qué quiere estudiar. ¿Le sirve?',
    a: 'Para eso está. Empezamos con un diagnóstico y un test de compatibilidad, y en la segunda sesión ya tiene las carreras y universidades que mejor encajan con él o ella.',
  },
  {
    q: '¿Las sesiones son online?',
    a: 'Sí, todas. Se conecta desde casa, así que encaja con el horario del colegio y no hay desplazamientos.',
  },
  {
    q: '¿Qué incluye exactamente el precio?',
    a: `Las 8 sesiones del programa por ${PRECIO}. La sesión de inglés es una evaluación de su nivel con nuestra profe. La summer school, el apoyo para la PAU y las clases de inglés posteriores se pagan aparte.`,
  },
  {
    q: '¿Quiénes son los mentores?',
    a: 'Exalumnos que ya han estudiado la carrera que le interesa. Tiene una mentoría por cada una de sus 3 favoritas, para que se lo cuente alguien que lo ha vivido de verdad.',
  },
  {
    q: '¿Y cuando llegue a 2º?',
    a: `Puede seguir con Robin en 2º de Bachillerato con un ${DESCUENTO} de descuento, y le acompañamos en la aplicación.`,
  },
  {
    q: '¿Cuánto cuesta la llamada? ¿Tiene que estar mi hijo o hija?',
    a: 'La llamada es gratis y sin compromiso: 30 minutos, online. Lo ideal es que os conectéis juntos, así resolvemos vuestras dudas y las suyas a la vez.',
  },
];

---

<Base
  pageClass="page-rj"
  title="Robin Junior: que tu hijo o hija llegue a 2º de Bach con un plan | Project Robin"
  description="Para las familias del webinar: Robin Junior son 8 sesiones online de octubre a junio para que tu hijo o hija de 1º de Bachillerato pase de «no sé qué estudiar» a tener un plan. 1.499 €."
  image="/fotos/junior/robin-junior-hero.webp"
  noindex
  minimal
>
  <!-- HERO -->
  <section class="rj-hero">
    <span class="rj-hero-blob" aria-hidden="true"></span>
    <div class="rj-hero-inner">
      <div class="rj-hero-text">
        <p class="rj-pill">Nuevo · 1º de Bachillerato</p>
        <p class="rj-hero-for">Para las familias del webinar del 21 de noviembre</p>
        <h1 class="display-xl">Robin <span class="rj-hl">Junior</span></h1>
        <p class="lead">
          Maximiza las oportunidades de tu hijo o hija de entrar en la <strong class="rj-hl">carrera de sus sueños</strong>.
        </p>
        <p class="rj-hero-sub">Orientación académica desde 1º, para que llegue a 2º con las ideas claras.</p>
        <ul class="rj-chips">
          <li><strong>Oct → Jun</strong> acompañamiento</li>
          <li><strong>8</strong> sesiones online</li>
          <li><strong>Países Bajos</strong></li>
        </ul>
        <div class="btn-row">
          <a class="btn rj-btn-big rj-pulse" href="#reserva">Reservar llamada gratuita</a>
          <a class="rj-link" href="#programa">Ver el programa ↓</a>
        </div>
      </div>
      <div class="rj-hero-art">
        <span class="rj-sun" aria-hidden="true"></span>
        <img
          src="/fotos/junior/robin-junior-hero.webp"
          alt="Dos estudiantes de Robin con la sudadera del programa"
          width="900"
          height="1200"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- MARQUEE -->
  <div class="rj-marquee-clip">
    <div class="rj-marquee" aria-label="Lo que incluye Robin Junior">
      <ul class="rj-marquee-track">
        {marquee.map((m) => <li>{m}</li>)}
        {marquee.map((m) => <li aria-hidden="true">{m}</li>)}
      </ul>
    </div>
  </div>

  <!-- POR QUÉ EN 1º -->
  <section class="rj-section rj-why">
    <div class="rj-wrap rj-wrap--mid">
      <p class="eyebrow rj-eyebrow">Sin rodeos</p>
      <h2 class="display-md rj-title">2º de Bach no es el momento de decidir</h2>
      <div class="rj-why-grid">
        <div class="rj-why-card is-bad">
          <p class="rj-why-label">Si empieza en 2º</p>
          <p>La PAU, las notas que cuentan y los plazos de aplicación llegan a la vez. Elige carrera con prisas y con lo que le ha contado un amigo.</p>
        </div>
        <div class="rj-why-card is-good">
          <p class="rj-why-label">Si empieza en 1º</p>
          <p>Llega a 2º sabiendo qué quiere estudiar y dónde, ha hablado con gente que ya lo estudia y su solicitud ya tiene puntos extra.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROGRAMA -->
  <section class="rj-section rj-plan" id="programa">
    <div class="rj-wrap rj-wrap--mid">
      <p class="eyebrow rj-eyebrow">Su año con Robin</p>
      <h2 class="display-md rj-title">
        De «no sé qué estudiar»<br />a <span class="rj-hl-dark">tener un plan</span>
      </h2>
      <p class="rj-plan-sub">8 sesiones online · de octubre a junio</p>
      <ol class="rj-timeline">
        {
          sesiones.map((s) => (
            <li class:list={['rj-step', { 'is-main': s.destacado }]}>
              <span class="rj-step-n" aria-hidden="true">{s.n}</span>
              <div class="rj-step-card">
                <p class="rj-step-kicker">{s.kicker}</p>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
                {s.chip && <span class="rj-step-chip">{s.chip}</span>}
              </div>
            </li>
          ))
        }
      </ol>
      <div class="btn-row btn-row--center">
        <a class="btn btn-navy rj-btn-big" href="#reserva">Quiero un plan para mi hijo o hija</a>
      </div>
    </div>
  </section>

  <!-- FOTO -->
  <figure class="rj-band">
    <img src="/fotos/junior/robin-junior-bicis.webp" alt="Estudiantes en bici por una calle de Países Bajos" width="1600" height="1200" loading="lazy" />
  </figure>

  <!-- Y ADEMÁS -->
  <section class="rj-section rj-extras">
    <div class="rj-wrap rj-wrap--mid">
      <p class="rj-tag">Y además</p>
      <h2 class="display-md rj-extras-title">Todo lo que suma <span class="rj-hl">a su solicitud</span></h2>
      <ul class="rj-extras-list">
        {
          extras.map((e) => (
            <li class="rj-extra">
              <div>
                <h3>
                  <span aria-hidden="true">{e.emoji}</span> {e.title}
                </h3>
                <p>{e.text}</p>
                {e.aparte && <p class="rj-extra-note">Se paga aparte</p>}
              </div>
              <span class:list={['rj-badge', { 'is-soft': e.opcional }]}>{e.badge}</span>
            </li>
          ))
        }
      </ul>

      <!-- PRECIO -->
      <div class="rj-price">
        <div>
          <p class="rj-price-kicker">Robin Junior · Programa completo</p>
          <p class="rj-price-num">{PRECIO}</p>
          <p class="rj-price-note">{DESCUENTO} si sigue con Robin en 2º de Bachillerato</p>
        </div>
        <span class="rj-price-badge" aria-hidden="true">{DESCUENTO}</span>
      </div>
    </div>
  </section>

  <!-- CUENTAS CLARAS + RESERVA -->
  <section class="rj-section rj-book-sec">
    <div class="rj-wrap rj-book-grid">
      <div class="rj-parents">
        <p class="rj-tag rj-tag--navy">Sin letra pequeña</p>
        <h2 class="title">Lo que incluye y lo que no</h2>
        <p>Antes de decidir, los números claros:</p>
        <dl class="rj-parents-list">
          {
            cuentas.map((p) => (
              <div>
                <dt>{p.k}</dt>
                <dd>{p.v}</dd>
              </div>
            ))
          }
        </dl>
        <p class="rj-parents-foot">¿Más dudas? Las resolvemos en la llamada informativa: gratis y sin compromiso.</p>
      </div>

      <div class="rj-card" id="reserva">
        <p class="rj-card-kicker">Gratis · 30 min · Online</p>
        <h2 class="title">Reserva tu llamada informativa</h2>
        <p class="rj-card-sub">Elige día y hora. Te llega al momento la invitación con el enlace de Google Meet. Lo ideal es que os conectéis juntos, tú y tu hijo o hija.</p>
        <BookingWidget
          tag={TAG}
          compact
          cursoOptions={CURSOS}
          cursoSelected={CURSOS[0]}
          cursoLegend="¿En qué curso está?"
          submitLabel="Confirmar mi llamada gratuita"
        >
          <p slot="fallback" class="b-fallback rj-fallback">
            ¿Ningún horario os encaja? Escríbenos a
            <a href={`mailto:${CONTACT.email}?subject=Robin%20Junior`}>{CONTACT.email}</a> y te buscamos hueco.
          </p>
        </BookingWidget>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="rj-section rj-faq-sec">
    <div class="rj-wrap rj-wrap--narrow">
      <p class="eyebrow rj-eyebrow">Preguntas frecuentes</p>
      <h2 class="display-md rj-title">Lo que nos preguntan las familias</h2>
      <div class="rj-faq">
        {
          faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CIERRE -->
  <section class="rj-final">
    <div class="rj-final-inner">
      <h2 class="display-md">Que empiece en 1º<br /><span class="rj-hl">y llegue a 2º con ventaja</span></h2>
      <p class="lead">{DESCUENTO} para continuar en 2º de Bach. Pide tu llamada informativa sin compromiso.</p>
      <a class="btn rj-btn-big rj-btn-xl rj-pulse" href="#reserva">Reservar mi llamada gratuita</a>
    </div>
  </section>

  <!-- CTA FIJO EN MÓVIL -->
  <div class="rj-sticky" data-rj-sticky>
    <a class="btn rj-btn-big" href="#reserva">Reservar llamada gratuita</a>
  </div>

  <script is:inline>
    // El botón fijo del móvil se esconde cuando ya se ve el reservador
    (function () {
      var bar = document.querySelector('[data-rj-sticky]');
      var card = document.getElementById('reserva');
      if (!bar || !card || !('IntersectionObserver' in window)) return;
      new IntersectionObserver(
        function (entries) {
          bar.classList.toggle('is-hidden', entries[0].isIntersecting);
        },
        { threshold: 0.05 }
      ).observe(card);
    })();
  </script>
</Base>
