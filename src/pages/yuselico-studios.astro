---
// Landing de campaña (Yuselico Studios · promotor: Chema).
// NO se enlaza desde ninguna parte de la web, no sale en el sitemap y lleva noindex:
// solo se llega con el enlace directo /yuselico-studios/.
// Los leads llegan a Notion con la etiqueta "yuselico-studios".
import Base from '../layouts/Base.astro';
import YouTube from '../components/YouTube.astro';
import LeadForm from '../components/LeadForm.astro';

// Vídeo del promotor (provisional: cambiar por el definitivo de Chema)
const VIDEO = 'https://www.youtube.com/watch?v=caxYEaJ7Ei0';
---

<Base title="¿Tú también quieres vivir esta experiencia en Países Bajos? | Project Robin" noindex>
  <section class="lp">
    <div class="lp-inner">
      <h1 class="display-md lp-title">¿Tú también quieres vivir esta experiencia en Países Bajos?</h1>
      <div class="lp-video">
        <YouTube url={VIDEO} title="Chema cuenta su experiencia en Países Bajos" />
      </div>
    </div>
  </section>

  <section class="lp-form" id="contacto">
    <div class="form-card">
      <h2 class="display-md lp-title">Contacta con Robin y hazlo posible</h2>
      <LeadForm form="contacto" tag="yuselico-studios" submitLabel="Quiero que me contactéis" />
    </div>
  </section>
</Base>

<style>
  .lp {
    background: var(--navy);
    border-radius: 0 0 24px 24px;
    padding-block: clamp(50px, 7vw, 90px);
  }
  .lp-inner {
    max-width: 960px;
    margin: 0 auto;
    padding-inline: var(--gutter);
    display: grid;
    gap: clamp(28px, 4vw, 44px);
    justify-items: center;
    text-align: center;
  }
  .lp .lp-title {
    color: var(--cream-text);
  }
  .lp-title {
    max-width: 860px;
  }
  .lp-video {
    width: 100%;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.3);
    border-radius: 18px;
  }
  /* El formulario sube sobre el final del bloque azul y ocupa casi todo el ancho */
  .lp {
    padding-bottom: clamp(120px, 14vw, 170px) !important;
  }
  .lp-form {
    padding: 0 var(--gutter) clamp(50px, 7vw, 90px);
    margin-top: clamp(-120px, -10vw, -80px);
    position: relative;
  }
  .form-card {
    max-width: 1180px;
    margin: 0 auto;
    background: var(--white);
    border-radius: 24px;
    box-shadow: 0 24px 60px rgba(45, 58, 100, 0.18);
    padding: clamp(26px, 4vw, 56px);
    display: grid;
    gap: clamp(22px, 3vw, 34px);
  }
  .form-card .lp-title {
    text-align: center;
    margin: 0 auto;
  }
  /* 4 campos por fila en escritorio: nombre, email, teléfono y servicio; el mensaje debajo */
  @media (min-width: 900px) {
    .form-card :global(.form-grid) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 16px 18px;
    }
    .form-card :global(.form-grid .full) {
      grid-column: auto;
    }
    .form-card :global(.form-grid .field:last-child) {
      grid-column: 1 / -1;
    }
  }
  .form-card :global(textarea) {
    min-height: 120px;
  }
  .form-card :global(.lead-form .btn) {
    justify-self: center !important;
    min-width: 280px;
  }
  .form-card :global(.consent) {
    justify-content: center;
  }
</style>
