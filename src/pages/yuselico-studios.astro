---
// Landing de campaña (Yuselico Studios · promotor: Chema).
// NO se enlaza desde ninguna parte de la web, no sale en el sitemap y lleva noindex:
// solo se llega con el enlace directo /yuselico-studios/.
// Los leads llegan a Notion con la etiqueta "yuselico-studios".
import Base from '../layouts/Base.astro';
import YouTube from '../components/YouTube.astro';
import LeadForm from '../components/LeadForm.astro';

// Vídeo del promotor (provisional: cambiar por el definitivo de Chema)
const VIDEO = 'https://www.youtube.com/watch?v=caxYEaJ7Ei0';
---

<Base title="¿Tú también quieres vivir esta experiencia en Países Bajos? | Project Robin" noindex>
  <section class="lp">
    <div class="lp-inner">
      <h1 class="display-md lp-title">¿Tú también quieres vivir esta experiencia en Países Bajos?</h1>
      <div class="lp-video">
        <YouTube url={VIDEO} title="Chema cuenta su experiencia en Países Bajos" />
      </div>
    </div>
  </section>

  <section class="lp-form" id="contacto">
    <div class="lp-inner">
      <h2 class="display-md lp-title">Contacta con Robin y hazlo posible</h2>
      <div class="form-card">
        <LeadForm form="contacto" tag="yuselico-studios" submitLabel="Quiero que me contactéis" />
      </div>
    </div>
  </section>
</Base>

<style>
  .lp {
    background: var(--navy);
    border-radius: 0 0 24px 24px;
    padding-block: clamp(50px, 7vw, 90px);
  }
  .lp-inner {
    max-width: 960px;
    margin: 0 auto;
    padding-inline: var(--gutter);
    display: grid;
    gap: clamp(28px, 4vw, 44px);
    justify-items: center;
    text-align: center;
  }
  .lp .lp-title {
    color: var(--cream-text);
  }
  .lp-title {
    max-width: 860px;
  }
  .lp-video {
    width: 100%;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.3);
    border-radius: 18px;
  }
  .lp-form {
    padding-block: clamp(50px, 7vw, 90px);
  }
  .form-card {
    width: 100%;
    max-width: 720px;
    text-align: left;
    background: var(--sky);
    border-radius: 20px;
    padding: clamp(22px, 4vw, 40px);
  }
</style>
