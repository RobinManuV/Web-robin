---
import '../styles/pages/mensaje.css';
import Base from '../layouts/Base.astro';
---

<Base pageClass="page-mensaje" title="Página no encontrada | Project Robin" noindex>
  <section class="container center message">
    <img src="/wp-content/uploads/2026/04/Robin-en-Bici.png" alt="" width="220" class="message-img" />
    <h1 class="display-md">Esta página se ha perdido por los canales</h1>
    <p class="lead message-lead">No la encontramos, pero seguro que te ayudamos a encontrar lo que buscas.</p>
    <div class="btn-row btn-row--center">
      <a class="btn" href="/">Ir al inicio</a>
      <a class="btn btn-outline" href="/destinos/">Estudiar en Holanda</a>
      <a class="btn btn-outline" href="/contacto/">Contacto</a>
    </div>
  </section>
</Base>
