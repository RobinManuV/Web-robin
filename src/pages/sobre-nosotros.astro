---
import '../styles/pages/sobre-nosotros.css';
import Base from '../layouts/Base.astro';
import YouTube from '../components/YouTube.astro';
import { EQUIPO } from '../data/site.js';

// Equipo (foto redonda + nombre + puesto). Sin `photo` se muestra un círculo con las iniciales:
// para poner la foto, añade `photo: '/ruta/foto.webp'` a esa persona. Los apellidos de los
// miembros que solo tienen nombre de pila se añaden en `name`.
const FOTO_B = '/wp-content/uploads/2026/10/'; // segunda cara (pájaro) del efecto moneda
const equipo = [
  { name: EQUIPO[0].name, role: 'CEO', photo: `${FOTO_B}noel.webp`, linkedin: EQUIPO[0].linkedin, photoBack: `${FOTO_B}noel-pajaro.webp` },
  { name: EQUIPO[1].name, role: 'COO & CMO', photo: `${FOTO_B}maria.webp`, linkedin: EQUIPO[1].linkedin, photoBack: `${FOTO_B}maria-pajaro.webp` },
  { name: EQUIPO[2].name, role: 'CTO', photo: `${FOTO_B}manuel.webp`, linkedin: EQUIPO[2].linkedin, photoBack: `${FOTO_B}manuel-pajaro.webp` },
  { name: 'Santiago Martín', role: 'Jefe de ingenieros', photo: `${FOTO_B}santiago.webp`, photoBack: `${FOTO_B}santiago-pajaro.webp` },
  { name: 'Ignacio Diaz', role: 'Director del programa de Aeroespaciales', photo: `${FOTO_B}nacho.webp`, photoBack: `${FOTO_B}nacho-pajaro.webp` },
  { name: 'Marc Eliers', role: 'Responsable territorial de Portugal', photo: `${FOTO_B}marc.webp`, photoBack: `${FOTO_B}marc-pajaro.webp` },
  { name: 'Candela Cortés', role: 'Directora de Orientación y estrategia académica', photo: `${FOTO_B}candela.webp`, photoBack: `${FOTO_B}candela-pajaro.webp` },
  {
    name: 'Jaime Nales',
    role: 'Encargado de acogida',
    photo: `${FOTO_B}jaime-nales.webp`,
    photoBack: `${FOTO_B}jaime-nales-pajaro.webp`,
  },
  { name: 'Graciela Gavira', role: 'Encargada de creación de contenido', photo: `${FOTO_B}graciela.webp`, photoBack: `${FOTO_B}graciela-pajaro.webp` },
  { name: 'Myriam Leon', role: 'Responsable de ventas B2B', photo: `${FOTO_B}miriam.webp`, photoBack: `${FOTO_B}miriam-pajaro.webp` },
];
const iniciales = (n) => n.split(' ').slice(0, 2).map((w) => w[0]).join('').toUpperCase();
const prensa = [
  {
    medio: 'Intereconomía',
    sub: 'Programa “Empresas con futuro”',
    kicker: 'Nos entrevistó Intereconomía',
    title: '¿Qué es Project Robin y por qué lo creamos?',
    text: 'Conocemos un poco más a fondo con esta entrevista cómo nació Project Robin y cuáles son nuestros próximos pasos para seguir a futuros estudiantes.',
    cta: 'Ver en YouTube',
    url: 'https://youtu.be/tJBmRg1Jg80',
  },
  {
    medio: 'Onda Cero',
    sub: 'Radio nacional',
    kicker: 'Nos entrevistó Onda Cero',
    title: 'Oportunidades internacionales reales para jóvenes',
    text: 'En esta charla revelamos nuestro propósito: la forma en que conectamos jóvenes con oportunidades internacionales reales, no promesas.',
    cta: 'Escuchar podcast',
    url: 'https://youtu.be/DdDkl6phoI8',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'Sobre Project Robin',
  url: 'https://project-robin.com/sobre-nosotros/',
  mainEntity: {
    '@id': 'https://project-robin.com/#organization',
    founder: EQUIPO.map((m) => ({ '@type': 'Person', name: m.name, sameAs: m.linkedin, alumniOf: 'Maastricht University' })),
  },
};
---

<Base pageClass="page-sobre-nosotros"
  title="Sobre Project Robin | Equipo y experiencia"
  description="Conoce al equipo de Project Robin y cómo acompañamos a estudiantes y familias en la elección de universidad y la preparación de su experiencia."
  schema={schema}
>
  <section class="intro bg-cream">
    <div class="container-narrow center">
      <p class="eyebrow">Sobre nosotros</p>
      <h1 class="display">Tus compañeros en la aventura de estudiar en el extranjero</h1>
      <p class="text">
        En Project Robin combinamos experiencia real y acompañamiento cercano para que estudiar en el extranjero deje de ser un sueño y se convierta en un plan. Te lo contamos a ti, como nos hubiera gustado que nos lo contaran a nosotros.
      </p>
    </div>
  </section>

  <section class="container story">
    <div class="story-card">
      <div class="story-head">
        <p class="eyebrow text-accent">Nuestra historia</p>
        <h2 class="display-md">Hicimos este camino antes que tú</h2>
      </div>
      <div class="story-body">
        <p>
          Hace unos años tomamos la mejor y más importante decisión de nuestras vidas: irnos a estudiar al extranjero, concretamente a los Países Bajos.
        </p>
        <p>
          Por aquel entonces, sentimos la falta de una guía clara y cercana. Nosotros llegamos como pollos sin cabeza, sin residencia reservada y sin enterarnos de mucho. Aun así tuvimos los tres mejores años de nuestras vidas, y tanto nosotros como nuestras familias acabamos tan satisfechos que nuestros hermanos fueron detrás.
        </p>
        <p>
          Así nació <strong class="text-accent">Project Robin</strong>, un hermano mayor para que ninguno de vosotros cometa los errores que cometimos nosotros y con el consejo y cercanía que nosotros hubiésemos necesitado.
        </p>
        <p>
          Como un hermano mayor estamos aquí para guiaros, pero también para gestionarlo todo, aseguraros el alojamiento y resolver todas las dudas que se os puedan ocurrir desde el día uno hasta que ya estéis allí. Y así, no os tengáis que preocupar de nada salvo de estudiar y disfrutar al máximo de lo que serán los tres mejores años de vuestras vidas.
        </p>
      </div>
    </div>
    <figure class="story-photo">
      <img
        src="/wp-content/uploads/2026/10/equipo-robin.webp"
        alt="El equipo de Project Robin sentado en fila sobre una repisa, con las camisetas blancas de Robin, y una persona saludando a cámara"
        width="1400"
        height="1050"
        loading="lazy"
      />
    </figure>
  </section>

  <section class="container crew">
    <p class="eyebrow center">El equipo</p>
    <h2 class="display-md center">Ponle cara al hermano mayor</h2>
    <p class="text center">Entre todos lo gestionamos todo para que tú solo tengas que estudiar. Hacer la maleta sí es cosa tuya.</p>
    <ul class="crew-grid">
      {
        equipo.map((m) => (
          <li class="member">
            <span class={`avatar${m.photo ? '' : ' avatar--ph'}${m.photoBack ? ' avatar--flip' : ''}`}>
              {m.photoBack ? (
                <span class="flip">
                  {m.photo ? (
                    <img class="face face--front" src={m.photo} alt={m.name} width="170" height="170" loading="lazy" />
                  ) : (
                    <span class="face face--front face--initials" aria-hidden="true">
                      {iniciales(m.name)}
                    </span>
                  )}
                  <img class="face face--back" src={m.photoBack} alt="" width="170" height="170" loading="lazy" />
                </span>
              ) : m.photo ? (
                <img src={m.photo} alt={m.name} width="170" height="170" loading="lazy" />
              ) : (
                <span aria-hidden="true">{iniciales(m.name)}</span>
              )}
            </span>
            <h3 class="m-name">
              {m.linkedin ? (
                <a href={m.linkedin} target="_blank" rel="noopener">
                  {m.name}
                </a>
              ) : (
                m.name
              )}
            </h3>
            <p class="m-role">{m.role}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="press bg-cream">
    <div class="container">
      <p class="eyebrow center">Nos entrevistaron</p>
      <h2 class="display-md center">Por qué cientos de estudiantes se fían de nosotros, descúbrelo</h2>
      <p class="text center">Conversaciones a fondo con medios nacionales sobre Project Robin y lo que hacemos.</p>
      <div class="press-grid">
        {
          prensa.map((p) => (
            <article class="press-card">
              <div class="press-media">
                <YouTube url={p.url} title={`${p.medio}: ${p.title}`} rounded={false} />
              </div>
              <div class="press-body">
                <p class="medio">
                  {p.medio} · <em>{p.sub}</em>
                </p>
                <p class="kicker">{p.kicker}</p>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
                <a class="btn btn-sm" href={p.url} target="_blank" rel="noopener">
                  {p.cta}
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="world bg-navy center">
    <h2 class="display-md">The world is your campus</h2>
    <p class="text">Somos un equipo que transforma el sueño de estudiar fuera en un plan real. Tan prácticos como tus padres, tan acompañantes como tus amigos y tan ambiciosos como tú.</p>
    <a class="btn" href="/contacto/?origen=sobre-nosotros">Reserva tu consulta gratuita</a>
  </section>
</Base>

