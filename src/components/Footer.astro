---
import '../styles/components/footer.css';
import { FOOTER, CONTACT, SITE } from '../data/site.js';
const columns = FOOTER.columns;
const year = new Date().getFullYear();
const path = Astro.url.pathname;
---

<footer class="site-footer">
  <div class="inner" style={`--cols:${columns.length}`}>
    <div class="brand">
      <a href="/" aria-label="Project Robin, inicio">
        <img src="/wp-content/uploads/2026/04/Copy-of-Logo-en-blanco-con-fondo-transparente-768x626.png" alt="Project Robin" width="300" height="245" />
      </a>
      <p class="tagline">{FOOTER.tagline}</p>
      <p class="subtitle">{FOOTER.subtitle}</p>
    </div>

    {
      columns.map((col) => (
        <nav class="col" aria-label={col.title}>
          <p class="col-title">{col.title}</p>
          <ul>
            {col.links.map((l) => (
              <li>
                <a href={l.href} class:list={{ current: path === l.href }}>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

    <div class="col contact">
      <p class="col-title">¡Contactanos!</p>
      <p class="label">Email</p>
      <p><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></p>
      <p class="label">Teléfono</p>
      <p>
        <a href={`tel:${CONTACT.phone.replace(/\s/g, '')}`}>{CONTACT.phone}</a>
      </p>
      <p class="city">{CONTACT.city}</p>
    </div>
  </div>

  <div class="bottom">
    <a class="social" href={CONTACT.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn de Project Robin">
      <svg viewBox="0 0 448 512" aria-hidden="true"><path fill="currentColor" d="M416 32H31.9C14.3 32 0 46.5 0 64.3v383.4C0 465.5 14.3 480 31.9 480H416c17.6 0 32-14.5 32-32.3V64.3c0-17.8-14.4-32.3-32-32.3zM135.4 416H69V202.2h66.5V416zm-33.2-243c-21.3 0-38.5-17.3-38.5-38.5S80.9 96 102.2 96c21.2 0 38.5 17.3 38.5 38.5 0 21.3-17.2 38.5-38.5 38.5zm282.1 243h-66.4V312c0-24.8-.5-56.7-34.5-56.7-34.6 0-39.9 27-39.9 54.9V416h-66.4V202.2h63.7v29.2h.9c8.9-16.8 30.6-34.5 62.9-34.5 67.2 0 79.7 44.3 79.7 101.9V416z"></path></svg>
    </a>
    <p>Copyright © {year} Project Robin</p>
    <button type="button" class="cookie-link" data-open-cookies>Preferencias de cookies</button>
  </div>
</footer>

