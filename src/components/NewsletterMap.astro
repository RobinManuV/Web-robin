---
import '../styles/components/newsletter-map.css';
// Bloque final reutilizable: newsletter + mapa "Estudia en X" + logos de universidades
// (aparece en /destinos/, /estudiar-universidad-espana/ y /the-european-experience/).
import LeadForm from './LeadForm.astro';
const { tag, mapImg, title, text, logos = [] } = Astro.props;
---

<section class="nl">
  <div class="nl-head">
    <h2>Suscríbete a nuestra newsletter</h2>
    <p><strong>Únete sin miedo.</strong><br />No llenamos tu buzón, solo te contamos lo realmente importante.</p>
    <div class="nl-form">
      <LeadForm form="newsletter" tag={tag} submitLabel="Suscribirse" />
      <p class="small center">Tu privacidad es importante. Puedes darte de baja en cualquier momento.</p>
    </div>
  </div>

  <div class="map-card">
    {mapImg && <img class="map" src={mapImg} alt="" loading="lazy" />}
    <div class="map-body">
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    {
      logos.length > 0 && (
        <ul class="logos">
          {logos.map((l) => (
            <li>
              <img src={l.src} alt={l.alt} loading="lazy" />
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

