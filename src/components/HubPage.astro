---
import '../styles/pages/hub.css';
// Página "hub" de España y de The European Experience.
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import YouTube from './YouTube.astro';
import NewsletterMap from './NewsletterMap.astro';

const { h } = Astro.props;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: h.listTitle,
    itemListElement: h.unis.map((u, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: u.name,
      url: `https://project-robin.com/universidades/${u.slug}/`,
    })),
  },
];
const pasos = [
  { title: 'Entendemos tu perfil', text: 'Evaluamos tus intereses académicos, notas y metas para diseñar una estrategia personalizada.' },
  { title: 'Definimos tu ruta', text: h.paso2 },
  { title: 'Acompañamiento', text: 'Te guiamos paso a paso en el proceso de admisión, preparación de documentos y trámites de estancia.' },
];
const contact = `/contacto${h.tag === 'espana' ? '-estudiar-en-espana' : ''}/?origen=${h.tag}`;
---

<Base pageClass="page-hub" title={h.seoTitle} description={h.seoDesc} image={h.heroBg} schema={schema}>
  <section class="hero" style={`--bg:url('${h.heroBg}')`}>
    <div class="hero-inner">
      <p class="eyebrow">Tu próximo destino</p>
      <h1 class="display-xl">{h.h1}</h1>
      <p class="lead">{h.intro}</p>
      <ul class="tick-list hero-list">
        {h.heroBullets.map((b) => <li>{b}</li>)}
      </ul>
      <div class="btn-row">
        <a class="btn" href={contact}>Reserva tu consulta online</a>
        <a class="btn btn-outline-light" href="#pasos">Cómo funciona</a>
      </div>
    </div>
  </section>

  <section class="why bg-navy">
    <div class="container center">
      <p class="eyebrow">{h.whyEyebrow}</p>
      <h2 class="display-md why-title">{h.whyTitle}</h2>
      <p class="text why-text">{h.whyText}</p>
      <div class="why-grid">
        {
          h.why.map((w, i) => (
            <article class:list={['why-card', { mid: i === 1 }]}>
              <Icon name={w.icon} size={30} />
              <h3>{w.title}</h3>
              <p>{w.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {
    h.video && (
      <section class="section container video">
        <div class="stack stack--20">
          <p class="eyebrow">Experiencia real</p>
          <h2 class="display-md">Más que una carrera universitaria</h2>
          <p class="text">Te lo contamos sin filtros ni discursos de marketing: así es de verdad vivir y estudiar dentro de The European Experience, paso a paso y sin letra pequeña.</p>
          <a class="btn" href={contact}>Reservar entrevista</a>
        </div>
        <YouTube url={h.video} title="The European Experience" ratio="9 / 16" />
      </section>
    )
  }

  <section class="section bg-cream">
    <div class="container">
      <p class="eyebrow center">Nuestra red académica</p>
      <h2 class="display-md center net-title">{h.listTitle}</h2>
      {h.listText && <p class="text center net-text">{h.listText}</p>}
      <ul class="unis">
        {
          h.unis.map((u) => (
            <li class="uni">
              <a href={`/universidades/${u.slug}/`} class="uni-link">
                <div class="uni-img" style={u.cardImg ? `background-image:url('${u.cardImg}')` : ''}>
                  {u.city && <span class="uni-city">{u.city}</span>}
                </div>
                {u.cardLogo && <img class="uni-logo" src={u.cardLogo} alt={`Logo de ${u.name}`} loading="lazy" />}
                <h3>{u.name}</h3>
                {u.type && <p class="uni-type">{u.type}</p>}
                <p class="uni-text">{u.cardText}</p>
              </a>
              <a class="btn btn-sm" href={`/universidades/${u.slug}/`}>
                Saber más
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section container steps" id="pasos">
    <h2 class="display-md center">Diseñamos tu camino en tres sencillos pasos</h2>
    <div class="steps-grid">
      <ol>
        {
          pasos.map((p, i) => (
            <li>
              <span class="n">{i + 1}</span>
              <div>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <img src="/wp-content/uploads/2026/04/Grupo-254.png" alt="" loading="lazy" />
    </div>
    <p class="center"><a class="btn" href={contact}>Reservar entrevista</a></p>
  </section>

  <section class="band" style={`--bg:url('${h.bandBg}')`}>
    <p class="eyebrow">Mucho más que estudiar</p>
    <p class="display-md">Vive la aventura que transformará tu futuro personal y profesional</p>
    <a class="btn" href={contact}>Reserva tu consulta online</a>
  </section>

  <NewsletterMap tag={`newsletter-${h.tag}`} mapImg={h.mapImg} title={h.mapTitle} text={h.mapText} logos={h.unis.map((u) => ({ src: u.cardLogo || u.logo, alt: u.name }))} />
</Base>

