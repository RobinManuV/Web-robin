---
// Vídeo de YouTube "ligero": muestra la miniatura y solo carga YouTube al hacer clic
// (la página carga mucho más rápido y no pone cookies de YouTube antes de tiempo).
const { url, title = 'Vídeo', poster, ratio = '16 / 9', rounded = true } = Astro.props;

function getId(u) {
  if (!u) return null;
  const m =
    u.match(/youtu\.be\/([\w-]{11})/) ||
    u.match(/[?&]v=([\w-]{11})/) ||
    u.match(/shorts\/([\w-]{11})/) ||
    u.match(/embed\/([\w-]{11})/);
  return m ? m[1] : null;
}
const id = getId(url);
const thumb = poster || (id ? `https://i.ytimg.com/vi/${id}/hqdefault.jpg` : null);
---

{
  id && (
    <div class:list={['yt', { rounded }]} style={`aspect-ratio:${ratio}`} data-yt={id} data-title={title}>
      <img src={thumb} alt={title} loading="lazy" decoding="async" />
      <button type="button" class="play" aria-label={`Reproducir: ${title}`}>
        <svg viewBox="0 0 68 48" aria-hidden="true">
          <path d="M66.5 7.7c-.8-2.9-2.5-5.4-5.4-6.2C55.8.1 34 0 34 0S12.2.1 6.9 1.6C4 2.4 2.3 4.8 1.5 7.7 0 13 0 24 0 24s0 11 1.5 16.3c.8 2.9 2.5 5.4 5.4 6.2C12.2 47.9 34 48 34 48s21.8-.1 27.1-1.6c2.9-.8 4.6-3.2 5.4-6.2C68 35 68 24 68 24s0-11-1.5-16.3z" fill="#f00" />
          <path d="M45 24 27 14v20" fill="#fff" />
        </svg>
      </button>
    </div>
  )
}

<script>
  document.addEventListener('click', (e) => {
    const box = e.target.closest('[data-yt]');
    if (!box || box.dataset.loaded) return;
    box.dataset.loaded = '1';
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube-nocookie.com/embed/${box.dataset.yt}?autoplay=1&rel=0`;
    iframe.title = box.dataset.title || 'Vídeo';
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
    iframe.allowFullscreen = true;
    box.innerHTML = '';
    box.appendChild(iframe);
  });
</script>

<style is:global>
  .yt {
    position: relative;
    width: 100%;
    background: #000;
    overflow: hidden;
    cursor: pointer;
  }
  .yt.rounded {
    border-radius: 18px;
  }
  .yt > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .yt .play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 68px;
    height: 48px;
    border: 0;
    background: none;
    padding: 0;
    opacity: 0.9;
    transition: opacity 0.2s, transform 0.2s;
  }
  .yt:hover .play {
    opacity: 1;
    transform: scale(1.06);
  }
  .yt iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
