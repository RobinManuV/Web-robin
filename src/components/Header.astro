---
import '../styles/components/header.css';
import { NAV, SITE } from '../data/site.js';
import GeoHide from './GeoHide.astro';
import LangSwitch from './LangSwitch.astro';
const path = Astro.url.pathname;
const isActive = (item) =>
  path === item.href ||
  (item.href !== '/' && path.startsWith(item.href)) ||
  (item.children || []).some((c) => path.startsWith(c.href));
---

<header class="site-header" data-header>
  <div class="bar">
    <a class="logo" href="/" aria-label="Project Robin, inicio">
      <img src={SITE.logo} alt="Project Robin" width="80" height="40" />
    </a>

    <nav class="nav" id="main-navigation" aria-label="Menú principal" data-nav>
      <ul class="menu">
        {
          NAV.map((item) => {
            const li = (
              <li class:list={['item', { 'has-sub': item.children, active: isActive(item) }]}>
                <a href={item.href} class="top-link" data-nav-link>
                  {item.label}
                  {item.children && (
                    <svg class="caret" viewBox="0 0 10 6" aria-hidden="true">
                      <path d="M0 0l5 6 5-6z" fill="currentColor" />
                    </svg>
                  )}
                </a>
                {item.children && (
                  <button class="sub-toggle" type="button" aria-expanded="false" aria-label={`Abrir ${item.label}`}>
                    <svg viewBox="0 0 10 6" aria-hidden="true">
                      <path d="M0 0l5 6 5-6z" fill="currentColor" />
                    </svg>
                  </button>
                )}
                {item.children && (
                  <ul class="sub">
                    {item.children.map((c) => (
                      <li>
                        <a href={c.href} class:list={{ current: path === c.href }} data-nav-link>
                          {c.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
            // España no se muestra a quien entra desde España (edge function geo-espana)
            return item.geoHide ? <GeoHide>{li}</GeoHide> : li;
          })
        }
      </ul>
      <div class="mobile-ctas">
        <LangSwitch class="in-menu" />
        <a class="btn" href="/contacto/?origen=cabecera">Consulta Gratis</a>
        <a class="btn btn-outline" href={SITE.loginUrl}>Log In</a>
      </div>
    </nav>

    <div class="ctas">
      <LangSwitch />
      <a class="btn cta-main" href="/contacto/?origen=cabecera">Consulta Gratis</a>
      <a class="btn btn-outline cta-login" href={SITE.loginUrl}>Log In</a>
    </div>

    <button class="burger" type="button" aria-label="Abrir menú" aria-controls="main-navigation" aria-expanded="false" data-burger>
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<script>
  import { pick } from '../i18n/runtime.js';

  const T = pick({
    es: { open: 'Abrir menú', close: 'Cerrar menú', openItem: 'Abrir', closeItem: 'Cerrar', submenu: 'submenú' },
    en: { open: 'Open menu', close: 'Close menu', openItem: 'Open', closeItem: 'Close', submenu: 'submenu' },
    pt: { open: 'Abrir menu', close: 'Fechar menu', openItem: 'Abrir', closeItem: 'Fechar', submenu: 'submenu' },
    br: { open: 'Abrir menu', close: 'Fechar menu', openItem: 'Abrir', closeItem: 'Fechar', submenu: 'submenu' },
  });
  const header = document.querySelector('[data-header]');
  const burger = header?.querySelector('[data-burger]');
  const closeMenu = () => {
    if (!header || !burger) return;
    header.classList.remove('is-open');
    burger.setAttribute('aria-expanded', 'false');
    burger.setAttribute('aria-label', T.open);
    document.body.style.overflow = '';
  };
  const toggleMenu = () => {
    if (!header || !burger) return;
    const open = header.classList.toggle('is-open');
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? T.close : T.open);
    document.body.style.overflow = open ? 'hidden' : '';
  };
  burger?.addEventListener('click', toggleMenu);
  header?.querySelectorAll('.sub-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const li = btn.closest('.item');
      const open = li.classList.toggle('sub-open');
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', `${open ? T.closeItem : T.openItem} ${li.querySelector('.top-link')?.textContent?.trim() || T.submenu}`);
    });
  });
  header?.querySelectorAll('[data-nav-link]').forEach((link) => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });
  window.addEventListener('resize', () => {
    if (window.innerWidth > 1024) closeMenu();
  }, { passive: true });
  window.addEventListener('scroll', () => header?.classList.toggle('is-scrolled', window.scrollY > 8), { passive: true });
</script>

