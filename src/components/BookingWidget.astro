---
import '../styles/components/booking-widget.css';
// Reservador de citas conectado a Google Calendar (Noel, María y Manuel).
// Muestra solo huecos libres reales y crea el evento con Google Meet.
// `tag` identifica desde qué página se reserva (llega a Notion y a GTM).
const { tag = 'general', compact = false } = Astro.props;
---

<div class:list={['booking', { compact }]} data-booking data-tag={tag}>
  <p class="b-title">Reserva una hora con nuestro equipo</p>
  <p class="b-sub">Primera consulta gratuita - 30 minutos</p>

  <!-- Paso 1: elegir hueco -->
  <div class="step" data-step="slots">
    <div class="days" data-days hidden></div>
    <ul class="slots" data-slots aria-live="polite">
      {Array.from({ length: 5 }).map(() => <li class="slot skeleton" aria-hidden="true"><span></span><span></span></li>)}
    </ul>
    <button type="button" class="more" data-more hidden>Ver más horarios</button>
    <p class="b-fallback">¿Ningún horario te encaja? <a href={`/contacto/?origen=${tag}`}>Escríbenos</a></p>
  </div>

  <!-- Paso 2: datos -->
  <form class="step" data-step="form" hidden novalidate>
    <button type="button" class="back" data-back>← Cambiar horario</button>
    <p class="chosen" data-chosen></p>
    <div class="field">
      <label for={`bk-name-${tag}`}>Nombre y apellidos <span class="req">*</span></label>
      <input id={`bk-name-${tag}`} name="name" autocomplete="name" required />
    </div>
    <div class="field">
      <label for={`bk-email-${tag}`}>Email <span class="req">*</span></label>
      <input id={`bk-email-${tag}`} name="email" type="email" autocomplete="email" required />
    </div>
    <div class="field">
      <label for={`bk-phone-${tag}`}>Teléfono <span class="req">*</span></label>
      <input id={`bk-phone-${tag}`} name="phone" type="tel" autocomplete="tel" required />
    </div>
    <div class="field">
      <label for={`bk-msg-${tag}`}>¿Algo que debamos saber? <small>(opcional)</small></label>
      <textarea id={`bk-msg-${tag}`} name="message" rows="3" placeholder="Curso, carrera que te interesa, dudas…"></textarea>
    </div>
    <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <label class="consent">
      <input type="checkbox" name="consent" required />
      <span>He leído y acepto la <a href="/politica-de-privacidad/" target="_blank">política de privacidad</a>.</span>
    </label>
    <p class="form-status" data-status hidden></p>
    <button type="submit" class="btn full" data-submit>Confirmar reserva</button>
  </form>

  <!-- Paso 3: confirmación -->
  <div class="step done" data-step="done" hidden>
    <p class="done-title">¡Reserva confirmada! 🎉</p>
    <p data-done-text></p>
    <p class="small">Te hemos enviado la invitación con el enlace de Google Meet a tu email. Si no la ves, revisa la carpeta de spam.</p>
  </div>
</div>

<script>
  const fmtDay = new Intl.DateTimeFormat('es-ES', { weekday: 'long', day: 'numeric', month: 'short', timeZone: 'Europe/Madrid' });
  const fmtTime = new Intl.DateTimeFormat('es-ES', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Madrid' });
  const fmtKey = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Madrid' });
  const cap = (s) => s.charAt(0).toUpperCase() + s.slice(1).replace('.', '');

  // Caché compartida para no pedir la disponibilidad dos veces en la misma página
  let availabilityPromise;
  const getAvailability = () =>
    (availabilityPromise ??= fetch('/api/availability', { cache: 'no-store' }).then((r) => {
      if (!r.ok) throw new Error('availability ' + r.status);
      return r.json();
    }));

  document.querySelectorAll('[data-booking]').forEach((root) => {
    const tag = root.dataset.tag || 'general';
    const $ = (s) => root.querySelector(s);
    const steps = root.querySelectorAll('[data-step]');
    const show = (name) => steps.forEach((s) => (s.hidden = s.dataset.step !== name));
    const list = $('[data-slots]');
    const days = $('[data-days]');
    const more = $('[data-more]');
    const form = $('[data-step="form"]');
    const status = $('[data-status]');
    let slots = [];
    let chosen = null;
    let expanded = false;
    let activeDay = null;

    function slotButton(s) {
      const li = document.createElement('li');
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'slot';
      const d = new Date(s.start);
      b.innerHTML = `<span>${cap(fmtDay.format(d))}</span><strong>${fmtTime.format(d)}</strong>`;
      b.addEventListener('click', () => pick(s));
      li.appendChild(b);
      return li;
    }

    function render() {
      list.innerHTML = '';
      if (!slots.length) {
        list.innerHTML = '<li class="empty">Ahora mismo no hay huecos libres en las próximas dos semanas. Escríbenos y te buscamos uno.</li>';
        more.hidden = true;
        return;
      }
      if (!expanded) {
        days.hidden = true;
        slots.slice(0, 5).forEach((s) => list.appendChild(slotButton(s)));
        more.hidden = slots.length <= 5;
        return;
      }
      // Vista ampliada: pestañas por día
      const byDay = {};
      slots.forEach((s) => (byDay[fmtKey.format(new Date(s.start))] ??= []).push(s));
      const keys = Object.keys(byDay);
      activeDay = activeDay && byDay[activeDay] ? activeDay : keys[0];
      days.innerHTML = '';
      keys.forEach((k) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'day' + (k === activeDay ? ' is-active' : '');
        b.textContent = cap(fmtDay.format(new Date(byDay[k][0].start)));
        b.addEventListener('click', () => {
          activeDay = k;
          render();
        });
        days.appendChild(b);
      });
      days.hidden = false;
      byDay[activeDay].forEach((s) => list.appendChild(slotButton(s)));
      more.hidden = true;
    }

    function pick(s) {
      chosen = s;
      const d = new Date(s.start);
      $('[data-chosen]').textContent = `${cap(fmtDay.format(d))} · ${fmtTime.format(d)} (hora de Madrid)`;
      status.hidden = true;
      show('form');
      form.querySelector('input[name="name"]').focus();
    }

    more.addEventListener('click', () => {
      expanded = true;
      render();
    });
    $('[data-back]').addEventListener('click', () => show('slots'));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const data = Object.fromEntries(new FormData(form));
      const btn = $('[data-submit]');
      btn.disabled = true;
      btn.textContent = 'Reservando…';
      status.hidden = true;
      try {
        const res = await fetch('/api/book', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...data, start: chosen.start, tag, page: location.pathname }),
        });
        const out = await res.json().catch(() => ({}));
        if (!res.ok) throw Object.assign(new Error(out.error || 'Error'), { code: res.status });
        $('[data-done-text]').textContent = `Te esperamos el ${fmtDay.format(new Date(chosen.start))} a las ${fmtTime.format(new Date(chosen.start))}${out.host ? ` con ${out.host}` : ''}.`;
        show('done');
        window.dataLayer?.push({ event: 'booking_confirmed', lead_tag: tag, page_path: location.pathname });
      } catch (err) {
        status.hidden = false;
        status.dataset.state = 'error';
        status.textContent =
          err.code === 409
            ? 'Ese hueco se acaba de ocupar. Elige otro, por favor.'
            : 'No hemos podido confirmar la reserva. Inténtalo de nuevo o escríbenos a hello@project-robin.com.';
        if (err.code === 409) {
          slots = slots.filter((s) => s.start !== chosen.start);
          render();
          setTimeout(() => show('slots'), 1600);
        }
      } finally {
        btn.disabled = false;
        btn.textContent = 'Confirmar reserva';
      }
    });

    getAvailability()
      .then((data) => {
        slots = data.slots || [];
        render();
      })
      .catch(() => {
        list.innerHTML =
          '<li class="empty">No hemos podido cargar la agenda. Escríbenos y te proponemos un horario.</li>';
      });
  });
</script>

